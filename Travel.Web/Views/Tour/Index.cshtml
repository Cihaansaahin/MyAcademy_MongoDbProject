@model List<Travel.Web.DTOs.TourDtos.ResultTourDto>
@{
    var isEn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLower() == "en";
    ViewData["Title"] = L["Turlar"].Value;
    var destinations = ViewBag.Destinations as List<Travel.Web.DTOs.DestinationDtos.ResultDestinationDto>;
    var categories = ViewBag.Categories as List<Travel.Web.DTOs.CategoryDtos.ResultCategoryDto>;
}

@section Styles {
    <style>
        /* PAGE HEADER - MİKRO KOMPAKT */
        .page-head {
            position: relative;
            overflow: hidden;
            color: #fff;
            background: linear-gradient(120deg,rgba(14,42,59,.92) 0%,rgba(18,56,76,.85) 55%,rgba(11,127,128,.78) 100%), url('https://images.unsplash.com/photo-1488646953014-85cb44e25828?auto=format&fit=crop&w=2000&q=80') center/cover;
            padding: 1.6rem 0 1.8rem; /* 4rem yerine kompakt */
        }

            .page-head .eyebrow {
                color: #7fe3e3;
                font-size: .68rem;
                letter-spacing: 1.2px;
                font-weight: 700;
                text-transform: uppercase;
            }

            .page-head h1 {
                font-weight: 800;
                font-size: clamp(1.5rem, 2.4vw, 2.1rem);
                letter-spacing: -.5px;
                margin-top: .2rem;
                margin-bottom: .2rem;
            }

            .page-head p {
                color: rgba(255,255,255,.9);
                max-width: 58ch;
                margin-top: .2rem;
                font-size: .84rem;
                line-height: 1.4;
                margin-bottom: 0;
            }

        .breadcrumbz {
            font-size: .76rem;
            color: rgba(255,255,255,.7);
            margin-bottom: .4rem !important;
        }

            .breadcrumbz a {
                color: rgba(255,255,255,.7);
                text-decoration: none;
            }

                .breadcrumbz a:hover {
                    color: #fff;
                }

        /* LAYOUT */
        .listing {
            padding: 1.2rem 0 2.2rem; /* 3rem yerine yukarı çekildi */
        }

        /* SIDEBAR FILTER CARD */
        .filter-card {
            background: #fff;
            border-radius: 14px;
            box-shadow: var(--shadow-sm);
            border: 1px solid rgba(231,226,216,.7);
            padding: 1rem 1.1rem; /* 1.5rem yerine kompakt */
        }

            .filter-card h2 {
                font-family: 'Sora';
                font-weight: 700;
                font-size: 1rem;
                color: var(--navy);
                margin-bottom: .15rem;
            }

        .filter-sub {
            font-size: .76rem;
            color: var(--muted);
            margin-bottom: .8rem;
        }

        .filter-group {
            padding: .65rem 0; /* 1.1rem'den daraltıldı */
            border-top: 1px solid var(--line);
        }

            .filter-group:first-of-type {
                border-top: none;
                padding-top: .1rem;
            }

            .filter-group h3 {
                font-family: 'Sora';
                font-weight: 600;
                font-size: .74rem;
                text-transform: uppercase;
                letter-spacing: .08em;
                color: var(--navy);
                margin-bottom: .5rem;
            }

        .search-wrap {
            position: relative;
        }

            .search-wrap svg {
                position: absolute;
                left: .75rem;
                top: 50%;
                transform: translateY(-50%);
                color: var(--muted);
            }

            .search-wrap input {
                width: 100%;
                border: 1px solid var(--line);
                border-radius: 999px;
                padding: .45rem .8rem .45rem 2.1rem;
                font-size: .82rem;
                color: var(--navy);
                outline: none;
                background: var(--cream);
                transition: .2s;
            }

                .search-wrap input:focus {
                    border-color: var(--teal);
                    background: #fff;
                    box-shadow: 0 0 0 3px rgba(15,163,163,.12);
                }

        .fcheck {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: .4rem;
            cursor: pointer;
        }

            .fcheck:last-child {
                margin-bottom: 0;
            }

            .fcheck .lbl {
                display: flex;
                align-items: center;
                gap: .5rem;
                font-size: .82rem;
                color: var(--navy);
            }

            .fcheck input {
                width: 15px;
                height: 15px;
                accent-color: var(--teal-dark);
                cursor: pointer;
            }

            .fcheck .cnt {
                font-size: .72rem;
                color: var(--muted);
            }

        .stars-opt {
            color: #f4a92c;
            letter-spacing: 1px;
            font-size: .8rem;
        }

            .stars-opt .off {
                color: #d8cfc0;
            }

        .filter-actions {
            padding-top: .8rem;
            border-top: 1px solid var(--line);
            margin-top: .3rem;
        }

            .filter-actions .btn-teal {
                width: 100%;
                border-radius: 999px;
                padding: .55rem 1.2rem;
                font-size: .84rem;
                font-weight: 600;
            }

        .clear-link {
            display: block;
            text-align: center;
            margin-top: .5rem;
            font-size: .78rem;
            color: var(--muted);
            font-weight: 600;
            background: none;
            border: none;
            width: 100%;
            cursor: pointer;
        }

            .clear-link:hover {
                color: var(--teal-dark);
            }

        /* TOOLBAR */
        .toolbar {
            background: #fff;
            border-radius: 14px;
            box-shadow: var(--shadow-sm);
            border: 1px solid rgba(231,226,216,.7);
            padding: .65rem 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .8rem;
            flex-wrap: wrap;
            margin-bottom: .9rem;
        }

            .toolbar h2 {
                font-family: 'Sora';
                font-weight: 700;
                font-size: 1.05rem;
                color: var(--navy);
                margin: 0;
                line-height: 1.1;
            }

            .toolbar .count {
                font-size: .76rem;
                color: var(--muted);
            }

        .sort-wrap {
            display: flex;
            align-items: center;
            gap: .5rem;
        }

            .sort-wrap label {
                font-size: .78rem;
                color: var(--muted);
                font-weight: 600;
            }

            .sort-wrap select {
                border: 1px solid var(--line);
                border-radius: 999px;
                padding: .35rem 1.6rem .35rem .8rem;
                font-size: .8rem;
                font-weight: 600;
                color: var(--navy);
                background: #fff;
                outline: none;
                cursor: pointer;
            }

        .btn-filter-mobile {
            background: var(--navy);
            color: #fff;
            border: none;
            border-radius: 999px;
            font-weight: 600;
            padding: .4rem .9rem;
            font-size: .78rem;
        }

        /* ACTIVE CHIPS */
        .active-chips {
            display: flex;
            flex-wrap: wrap;
            gap: .4rem;
            margin-bottom: .8rem;
        }

        .chip {
            display: inline-flex;
            align-items: center;
            gap: .3rem;
            background: rgba(15,163,163,.1);
            color: var(--teal-dark);
            font-size: .74rem;
            font-weight: 600;
            padding: .22rem .65rem;
            border-radius: 999px;
            cursor: pointer;
            transition: .2s;
        }

            .chip:hover {
                background: rgba(15,163,163,.2);
            }

            .chip .x {
                font-weight: 700;
            }

        /* TOUR CARD - MİKRO KOMPAKT */
        .tour-card {
            background: #fff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 12px rgba(14,42,59,.05);
            transition: .25s;
            height: 100%;
            display: flex;
            flex-direction: column;
            border: 1px solid rgba(231,226,216,.7);
        }

            .tour-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 22px rgba(14,42,59,.1);
            }

        .tour-media {
            position: relative;
            height: 140px; /* 210px yerine kompakt */
            overflow: hidden;
        }

            .tour-media img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: .4s;
            }

        .tour-card:hover .tour-media img {
            transform: scale(1.05);
        }

        .tour-badge {
            position: absolute;
            top: .5rem;
            left: .5rem;
            background: rgba(255,255,255,.94);
            color: var(--navy);
            font-weight: 600;
            font-size: .65rem;
            padding: .18rem .5rem;
            border-radius: 999px;
        }

        .fav {
            position: absolute;
            top: .45rem;
            right: .5rem;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: rgba(255,255,255,.92);
            display: grid;
            place-items: center;
            color: var(--navy);
            cursor: pointer;
            border: none;
            transition: .2s;
        }

            .fav:hover {
                color: var(--teal-dark);
                transform: scale(1.08);
            }

            .fav.on {
                color: #e0575b;
            }

                .fav.on svg {
                    fill: currentColor;
                }

        .tour-body {
            padding: .7rem .85rem .8rem; /* Kompakt iç boşluk */
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .tour-topline {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: .1rem;
        }

        .tour-country {
            font-size: .7rem;
            color: var(--teal-dark);
            font-weight: 600;
        }

        .tour-cat {
            font-size: .65rem;
            color: var(--muted);
            background: var(--cream);
            border: 1px solid var(--line);
            padding: .1rem .45rem;
            border-radius: 999px;
        }

        .tour-title {
            font-family: 'Sora';
            font-weight: 700;
            font-size: .92rem;
            margin: .1rem 0 .25rem;
            color: var(--navy);
            line-height: 1.25;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .tour-meta {
            display: flex;
            align-items: center;
            gap: .6rem;
            font-size: .74rem;
            color: var(--muted);
            margin-bottom: .45rem;
        }

        .rating {
            color: #0e2a3b;
            font-weight: 600;
        }

            .rating .star {
                color: #f4a92c;
            }

        .tour-foot {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            margin-top: auto;
            padding-top: .35rem;
            border-top: 1px solid var(--line);
        }

        .price small {
            color: var(--muted);
            font-size: .65rem;
            display: block;
            line-height: 1;
        }

        .price b {
            font-family: 'Sora';
            font-size: 1.05rem;
            color: var(--navy);
            line-height: 1.1;
        }

            .price b span {
                font-size: .7rem;
                font-weight: 600;
                color: var(--muted);
            }

        .btn-incele {
            background: var(--navy);
            color: #fff;
            border-radius: 999px;
            font-size: .74rem;
            font-weight: 600;
            padding: .32rem .8rem;
            border: none;
            transition: .25s;
            text-decoration: none;
        }

            .btn-incele:hover {
                background: var(--teal-dark);
                color: #fff;
            }

        /* EMPTY */
        .empty-state {
            background: #fff;
            border-radius: var(--r);
            border: 1px solid rgba(231,226,216,.7);
            box-shadow: var(--shadow-sm);
            padding: 2.2rem 1.5rem;
            text-align: center;
        }

            .empty-state .ico {
                width: 48px;
                height: 48px;
                border-radius: 14px;
                background: rgba(15,163,163,.1);
                color: var(--teal-dark);
                display: grid;
                place-items: center;
                margin: 0 auto .8rem;
            }

            .empty-state h3 {
                font-family: 'Sora';
                font-weight: 700;
                color: var(--navy);
                font-size: 1.1rem;
            }

            .empty-state p {
                color: var(--muted);
                max-width: 40ch;
                margin: .3rem auto 1rem;
                font-size: .84rem;
            }

        /* PAGINATION */
        .pager {
            display: flex;
            justify-content: center;
            gap: .35rem;
            margin-top: 1.8rem;
        }

            .pager a {
                min-width: 36px;
                height: 36px;
                display: grid;
                place-items: center;
                border-radius: 10px;
                background: #fff;
                border: 1px solid var(--line);
                color: var(--navy);
                font-weight: 600;
                font-size: .84rem;
                transition: .2s;
                padding: 0 .3rem;
                text-decoration: none;
            }

                .pager a:hover {
                    border-color: var(--teal);
                    color: var(--teal-dark);
                }

                .pager a.active {
                    background: var(--navy);
                    color: #fff;
                    border-color: var(--navy);
                }

        /* MINI CTA */
        .mini-cta {
            background: var(--navy);
            border-radius: 18px;
            padding: 1.8rem 1.5rem;
            text-align: center;
            color: #fff;
            margin-top: 2.2rem;
        }

            .mini-cta .eyebrow {
                color: #7fe3e3;
                font-size: .68rem;
            }

            .mini-cta h2 {
                font-weight: 700;
                font-size: 1.25rem;
                letter-spacing: -.5px;
                margin-top: .3rem;
            }

            .mini-cta p {
                color: rgba(255,255,255,.82);
                max-width: 50ch;
                margin: .5rem auto 1rem;
                font-size: .84rem;
            }

            .mini-cta .btn-teal {
                padding: .45rem 1.2rem;
                font-size: .82rem;
            }

        .sticky-side {
            position: sticky;
            top: 80px;
        }

        @@media(max-width:991px) {
            .sticky-side {
                position: static;
            }
        }
    </style>
}

<!-- PAGE HEADER -->
<header class="page-head">
    <div class="container">
        <div class="breadcrumbz">
            <a href="/">@L["Ana Sayfa"]</a> · @L["Turlar"]
        </div>
        <div class="eyebrow">@L["Dünyayı keşfet"]</div>
        <h1>@L["Hayalindeki Turu Bul"]</h1>
        <p>
            @L["Avrupa'nın ikonik şehirlerinden Uzak Doğu'nun büyüleyici rotalarına kadar sana uygun seyahati keşfet."]
        </p>
    </div>
</header>

<!-- LISTING -->
<section class="listing">
    <div class="container">
        <div class="row g-3">

            <!-- SIDEBAR (desktop) -->
            <div class="col-lg-3 d-none d-lg-block">
                <div class="sticky-side">
                    <div class="filter-card" id="filterCardDesktop"></div>
                </div>
            </div>

            <!-- RESULTS -->
            <div class="col-lg-9">
                <!-- toolbar -->
                <div class="toolbar">
                    <div>
                        <h2>@L["Turlar"]</h2>
                        <div class="count"><span id="resultCount">@(Model?.Count ?? 0)</span> @L["tur bulundu"]</div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn-filter-mobile d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#filterOffcanvas">
                            @L["Filtrele"]
                        </button>
                        <div class="sort-wrap">
                            <label for="sortSelect" class="d-none d-sm-block">@L["Sırala:"]</label>
                            <select id="sortSelect">
                                <option value="onerilen">@L["Önerilen"]</option>
                                <option value="puan">@L["En Yüksek Puan"]</option>
                                <option value="fiyat-artan">@L["Fiyat: Düşükten Yükseğe"]</option>
                                <option value="fiyat-azalan">@L["Fiyat: Yüksekten Düşüğe"]</option>
                                <option value="yeni">@L["En Yeni Turlar"]</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- active chips -->
                <div class="active-chips" id="activeChips"></div>

                <!-- grid -->
                <div class="row g-3" id="tourGrid"></div>

                <!-- empty -->
                <div id="emptyState" style="display:none">
                    <div class="empty-state">
                        <div class="ico">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                        </div>
                        <h3>@L["Aradığın kriterlere uygun tur bulunamadı."]</h3>
                        <p>@L["Filtreleri biraz gevşetmeyi dene ya da tümünü temizleyerek yeniden başla."]</p>
                        <button class="btn-teal" type="button" onclick="clearFilters()" style="padding:.5rem 1.2rem;font-size:.82rem">@L["Filtreleri Temizle"]</button>
                    </div>
                </div>

                <!-- pagination -->
                <nav class="pager" id="pager" style="display:none">
                    <a href="#" class="nav-arrow" aria-label="Önceki">←</a>
                    <a href="#" class="active">1</a>
                    <a href="#">2</a>
                    <a href="#">3</a>
                    <a href="#" class="nav-arrow" aria-label="Sonraki">→</a>
                </nav>

                <!-- mini cta -->
                <div class="mini-cta">
                    <div class="eyebrow">@L["Yardımcı olalım"]</div>
                    <h2>@L["Aradığın Rotayı Bulamadın mı?"]</h2>
                    <p>@L["Hayalindeki destinasyonu bize söyle, sana uygun seyahat seçeneklerini birlikte bulalım."]</p>
                    <a href="/#iletisim" class="btn-teal" style="text-decoration:none">@L["Bize Ulaş"]</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- OFFCANVAS FILTERS (mobile) -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="filterOffcanvas" style="width:300px">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" style="font-family:'Sora';font-weight:700;color:var(--navy);font-size:1rem">@L["Filtrele"]</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <div class="filter-card" id="filterCardMobile" style="box-shadow:none;border:none;padding:0"></div>
    </div>
</div>

@section Scripts {
    <script>
        /* ---------- DATA ENTEGRASYONU ---------- */
        const isEn = @(isEn ? "true" : "false");

        const TOURS = [
        @if (Model != null && Model.Any())
        {
                    foreach (var t in Model)
                    {
                                var title = t.Title?.Value ?? "";
                                var catObj = categories?.FirstOrDefault(c => c.Id == t.CategoryId);
                                var catName = catObj?.Name?.Value ?? L["Tur"].Value;
                                var badgeText = t.IsPopular ? L["Popüler"].Value : "";
                                <text>{
                                            id: "@t.Id",
                                            title: "@Html.Raw(title.Replace("\"", "\\\""))",
                                            country: "@(t.Country ?? "")",
                                            city: "@(t.City ?? "")",
                                            ctry: "@(t.Country?.ToLower() ?? "")",
                                            dur: @t.DurationDays,
                                            durLabel: `@t.DurationDays @L["Gün"]`,
                                            rating: 4.9,
                                            reviews: 1200,
                                            price: @t.Price,
                                            cat: "@(t.CategoryId ?? "")",
                                            catLabel: "@catName",
                                            badge: "@badgeText",
                                            img: "@(string.IsNullOrEmpty(t.CoverImageUrl) ? "https://images.unsplash.com/photo-1502602898657-3e91760cbb34?auto=format&fit=crop&w=800&q=80" : t.CoverImageUrl)"
                                        },</text>
                            }
                }
                ];

                /* ---------- FILTER DEFINITIONS ---------- */
                const DEST_OPTS = [
                @if (destinations != null && destinations.Any())
                {
                            foreach (var d in destinations)
                            {
                                        <text>{ key: "@d.City.ToLower()", label: "@d.City" },</text>
                            }
                }
                ];

                const DUR_OPTS = [
                    {key:"1-3", label: isEn ? "1 - 3 Days" : "1 - 3 Gün", min:1, max:3},
                    {key:"4-5", label: isEn ? "4 - 5 Days" : "4 - 5 Gün", min:4, max:5},
                    {key:"6-7", label: isEn ? "6 - 7 Days" : "6 - 7 Gün", min:6, max:7},
                    {key:"8+",  label: isEn ? "8+ Days" : "8 Gün ve Üzeri", min:8, max:99}
                ];

                const PRICE_OPTS = [
                    {key:"p1", label:"0 - 25.000 ₺", min:0, max:25000},
                    {key:"p2", label:"25.000 - 40.000 ₺", min:25000, max:40000},
                    {key:"p3", label:"40.000 - 60.000 ₺", min:40000, max:60000},
                    {key:"p4", label: isEn ? "60.000 ₺ and above" : "60.000 ₺ ve üzeri", min:60000, max:9999999}
                ];

                const TYPE_OPTS = [
                @if (categories != null && categories.Any())
                {
                            foreach (var c in categories)
                            {
                                        var cName = c.Name?.Value ?? "";
                                        <text>{ id: "@c.Id", label: "@cName" },</text>
                            }
                }
                ];

                const RATING_OPTS = [
                    {key:"r45", label: isEn ? "4.5 & up" : "4.5 ve üzeri", val:4.5, stars:5},
                    {key:"r40", label: isEn ? "4.0 & up" : "4.0 ve üzeri", val:4.0, stars:4},
                    {key:"r35", label: isEn ? "3.5 & up" : "3.5 ve üzeri", val:3.5, stars:3}
                ];

                /* ---------- STATE ---------- */
                const state = { q:"", dest:[], dur:[], price:[], type:[], rating:null, sort:"onerilen" };

                function destCount(key){
                    return TOURS.filter(t => t.city.toLowerCase() === key || t.ctry === key).length;
                }

                function starsMarkup(n){
                    let s="";
                    for(let i=1;i<=5;i++){ s+= i<=n ? "★" : "<span class='off'>★</span>"; }
                    return s;
                }

                /* ---------- BUILD SIDEBAR HTML ---------- */
                function sidebarHTML(){
                    return `
                    <h2>${isEn ? "Filter Tours" : "Turları Filtrele"}</h2>
                    <p class="filter-sub">${isEn ? "Narrow down to find your best match." : "Sana en uygun rotayı bulmak için daralt."}</p>

                    <div class="filter-group">
                        <h3>${isEn ? "Search Tour" : "Tur Ara"}</h3>
                        <div class="search-wrap">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                            <input type="text" class="f-search" placeholder="${isEn ? "Search tour or city" : "Tur veya şehir ara"}" />
                        </div>
                    </div>

                    ${DEST_OPTS.length > 0 ? `
                    <div class="filter-group">
                        <h3>${isEn ? "Destination" : "Destinasyon"}</h3>
                        ${DEST_OPTS.map(o=>`
                            <label class="fcheck">
                                <span class="lbl"><input type="checkbox" class="f-dest" value="${o.key}"> ${o.label}</span>
                                <span class="cnt">(${destCount(o.key)})</span>
                            </label>`).join("")}
                    </div>` : ''}

                    <div class="filter-group">
                        <h3>${isEn ? "Duration" : "Tur Süresi"}</h3>
                        ${DUR_OPTS.map(o=>`
                            <label class="fcheck">
                                <span class="lbl"><input type="checkbox" class="f-dur" value="${o.key}"> ${o.label}</span>
                            </label>`).join("")}
                    </div>

                    <div class="filter-group">
                        <h3>${isEn ? "Price Range" : "Fiyat Aralığı"}</h3>
                        ${PRICE_OPTS.map(o=>`
                            <label class="fcheck">
                                <span class="lbl"><input type="checkbox" class="f-price" value="${o.key}"> ${o.label}</span>
                            </label>`).join("")}
                    </div>

                    ${TYPE_OPTS.length > 0 ? `
                    <div class="filter-group">
                        <h3>${isEn ? "Tour Type" : "Tur Tipi"}</h3>
                        ${TYPE_OPTS.map(o=>`
                            <label class="fcheck">
                                <span class="lbl"><input type="checkbox" class="f-type" value="${o.id}"> ${o.label}</span>
                            </label>`).join("")}
                    </div>` : ''}

                    <div class="filter-group">
                        <h3>${isEn ? "Rating" : "Değerlendirme"}</h3>
                        ${RATING_OPTS.map(o=>`
                            <label class="fcheck">
                                <span class="lbl"><input type="radio" name="f-rating" class="f-rating" value="${o.key}"> <span class="stars-opt">${starsMarkup(o.stars)}</span></span>
                                <span class="cnt">${o.label}</span>
                            </label>`).join("")}
                    </div>

                    <div class="filter-actions">
                        <button class="btn-teal" type="button" onclick="applyFromButton()">${isEn ? "Apply Filters" : "Filtreleri Uygula"}</button>
                        <button class="clear-link" type="button" onclick="clearFilters()">${isEn ? "Clear Filters" : "Filtreleri Temizle"}</button>
                    </div>`;
                }

                document.getElementById("filterCardDesktop").innerHTML = sidebarHTML();
                document.getElementById("filterCardMobile").innerHTML = sidebarHTML();

                /* ---------- READ INPUTS -> STATE ---------- */
                function syncState(){
                    const q = document.querySelector(".f-search")?.value.trim().toLowerCase() || "";
                    state.q = q;
                    state.dest  = [...document.querySelectorAll(".f-dest:checked")].map(i=>i.value);
                    state.dur   = [...document.querySelectorAll(".f-dur:checked")].map(i=>i.value);
                    state.price = [...document.querySelectorAll(".f-price:checked")].map(i=>i.value);
                    state.type  = [...document.querySelectorAll(".f-type:checked")].map(i=>i.value);
                    const r = document.querySelector(".f-rating:checked");
                    state.rating = r ? r.value : null;

                    state.dest  = [...new Set(state.dest)];
                    state.dur   = [...new Set(state.dur)];
                    state.price = [...new Set(state.price)];
                    state.type  = [...new Set(state.type)];
                }

                /* ---------- FILTER + SORT ---------- */
                function getFiltered(){
                    let list = TOURS.filter(t=>{
                        if(state.q){
                            const hay = (t.title + " " + t.country + " " + t.city).toLowerCase();
                            if(!hay.includes(state.q)) return false;
                        }
                        if(state.dest.length && !state.dest.includes(t.city.toLowerCase()) && !state.dest.includes(t.ctry)) return false;
                        if(state.dur.length){
                            const ok = state.dur.some(k=>{ const o=DUR_OPTS.find(d=>d.key===k); return t.dur>=o.min && t.dur<=o.max; });
                            if(!ok) return false;
                        }
                        if(state.price.length){
                            const ok = state.price.some(k=>{ const o=PRICE_OPTS.find(p=>p.key===k); return t.price>=o.min && t.price<o.max; });
                            if(!ok) return false;
                        }
                        if(state.type.length && !state.type.includes(t.cat)) return false;
                        if(state.rating){
                            const o = RATING_OPTS.find(r=>r.key===state.rating);
                            if(t.rating < o.val) return false;
                        }
                        return true;
                    });

                    switch(state.sort){
                        case "puan": list.sort((a,b)=>b.rating-a.rating); break;
                        case "fiyat-artan": list.sort((a,b)=>a.price-b.price); break;
                        case "fiyat-azalan": list.sort((a,b)=>b.price-a.price); break;
                        default: break;
                    }
                    return list;
                }

                /* ---------- RENDER CARDS ---------- */
                function fmt(n){ return n.toLocaleString(isEn ? "en-US" : "tr-TR"); }

                function cardHTML(t){
                    return `
                    <div class="col-md-6">
                        <article class="tour-card">
                            <div class="tour-media">
                                <img src="${t.img}" alt="${t.title}" loading="lazy" />
                                ${t.badge ? `<span class="tour-badge">${t.badge}</span>` : ''}
                                <button class="fav" aria-label="Favorilere ekle" onclick="this.classList.toggle('on')">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
                                </button>
                            </div>
                            <div class="tour-body">
                                <div class="tour-topline">
                                    <span class="tour-country">${t.country} · ${t.city}</span>
                                    <span class="tour-cat">${t.catLabel}</span>
                                </div>
                                <h3 class="tour-title" title="${t.title}">${t.title}</h3>
                                <div class="tour-meta">
                                    <span>🗓️ ${t.durLabel}</span>
                                    <span class="rating"><span class="star">★</span> ${t.rating.toFixed(1)} <span style="color:var(--muted);font-weight:400">(${fmt(t.reviews)})</span></span>
                                </div>
                                <div class="tour-foot">
                                    <div class="price"><small>${isEn ? "From" : "Kişi başı"}</small><b>${fmt(t.price)} <span>TL</span></b></div>
                                    <a href="/Tour/Detail/${t.id}" class="btn-incele">${isEn ? "Explore" : "Turu İncele"}</a>
                                </div>
                            </div>
                        </article>
                    </div>`;
                }

                /* ---------- ACTIVE CHIPS ---------- */
                function chipsHTML(){
                    const chips = [];
                    state.dest.forEach(k=>{ const o=DEST_OPTS.find(d=>d.key===k); if(o) chips.push({t:o.label, kind:"dest", v:k}); });
                    state.dur.forEach(k=>{ const o=DUR_OPTS.find(d=>d.key===k); if(o) chips.push({t:o.label, kind:"dur", v:k}); });
                    state.price.forEach(k=>{ const o=PRICE_OPTS.find(p=>p.key===k); if(o) chips.push({t:o.label, kind:"price", v:k}); });
                    state.type.forEach(v=>{ const o=TYPE_OPTS.find(c=>c.id===v); if(o) chips.push({t:o.label, kind:"type", v}); });
                    if(state.rating){ const o=RATING_OPTS.find(r=>r.key===state.rating); if(o) chips.push({t:o.label+" ★", kind:"rating", v:state.rating}); }
                    if(state.q) chips.push({t:'"'+state.q+'"', kind:"q", v:state.q});
                    return chips.map(c=>`<span class="chip" onclick="removeChip('${c.kind}','${(c.v+'').replace(/'/g,"")}')">${c.t} <span class="x">×</span></span>`).join("");
                }

                function removeChip(kind, v){
                    const uncheck = (sel,val)=>document.querySelectorAll(sel).forEach(i=>{ if(i.value===val) i.checked=false; });
                    if(kind==="dest") uncheck(".f-dest", v);
                    if(kind==="dur") uncheck(".f-dur", v);
                    if(kind==="price") uncheck(".f-price", v);
                    if(kind==="type") uncheck(".f-type", v);
                    if(kind==="rating") document.querySelectorAll(".f-rating").forEach(i=>i.checked=false);
                    if(kind==="q") document.querySelectorAll(".f-search").forEach(i=>i.value="");
                    syncState(); render();
                }

                /* ---------- MAIN RENDER ---------- */
                function render(){
                    const list = getFiltered();
                    const grid = document.getElementById("tourGrid");
                    const empty = document.getElementById("emptyState");
                    const pager = document.getElementById("pager");

                    document.getElementById("resultCount").textContent = list.length;
                    document.getElementById("activeChips").innerHTML = chipsHTML();

                    if(list.length===0){
                        grid.innerHTML = "";
                        empty.style.display = "block";
                        pager.style.display = "none";
                    } else {
                        grid.innerHTML = list.map(cardHTML).join("");
                        empty.style.display = "none";
                        pager.style.display = list.length > 6 ? "flex" : "none";
                    }
                }

                /* ---------- EVENTS ---------- */
                document.addEventListener("input", (e)=>{
                    if(e.target.matches(".f-search, .f-dest, .f-dur, .f-price, .f-type, .f-rating")){
                        syncState(); render();
                    }
                });

                document.getElementById("sortSelect").addEventListener("change", (e)=>{
                    state.sort = e.target.value; render();
                });

                function applyFromButton(){
                    syncState(); render();
                    const oc = document.getElementById("filterOffcanvas");
                    if(window.bootstrap && bootstrap.Offcanvas){
                        const inst = bootstrap.Offcanvas.getInstance(oc);
                        if(inst) inst.hide();
                    }
                }

                function clearFilters(){
                    document.querySelectorAll(".f-search").forEach(i=>i.value="");
                    document.querySelectorAll(".f-dest,.f-dur,.f-price,.f-type").forEach(i=>i.checked=false);
                    document.querySelectorAll(".f-rating").forEach(i=>i.checked=false);
                    state.sort = "onerilen";
                    document.getElementById("sortSelect").value = "onerilen";
                    syncState(); render();
                }

                // Başlangıç çalıştırması
                render();
        </script>
    }