@model dynamic
@{
    var isEn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLower() == "en";
    ViewData["Title"] = isEn ? "My Profile" : "Profilim";
    var reservations = ViewBag.Reservations as List<Travel.Web.DTOs.ReservationDtos.ResultReservationDto>;
    var comments = ViewBag.Comments as List<Travel.Web.DTOs.CommentDtos.ResultCommentDto>;
    var questions = ViewBag.Questions as List<Travel.Web.DTOs.QuestionDtos.ResultQuestionDto>;

    var upcomingTrips = reservations?.Where(r => r.SelectedTourDate >= DateTime.Now).ToList() ?? new List<Travel.Web.DTOs.ReservationDtos.ResultReservationDto>();
    var completedTrips = reservations?.Where(r => r.SelectedTourDate < DateTime.Now).ToList() ?? new List<Travel.Web.DTOs.ReservationDtos.ResultReservationDto>();
}

@section Styles {
    <style>
        .btn-outline {
            background: #fff;
            border: 1px solid var(--line);
            color: var(--navy);
            border-radius: 999px;
            font-weight: 600;
            padding: .55rem 1.15rem;
            font-size: .88rem;
            transition: .2s;
            cursor: pointer
        }

            .btn-outline:hover {
                border-color: var(--teal);
                color: var(--teal-dark)
            }

        /* PAGE HEAD */
        .prof-head {
            padding: 2rem 0 1.2rem
        }

        .crumb {
            font-size: .85rem;
            color: var(--muted);
            margin-bottom: 1rem
        }

            .crumb a {
                color: var(--muted);
                text-decoration: none
            }

                .crumb a:hover {
                    color: var(--teal-dark)
                }

            .crumb .cur {
                color: var(--navy);
                font-weight: 600
            }

        .prof-head h1 {
            font-weight: 800;
            font-size: clamp(1.8rem,3.2vw,2.5rem);
            letter-spacing: -.5px;
            color: var(--navy);
            margin: .35rem 0 .5rem
        }

        .prof-head p {
            color: var(--muted);
            max-width: 56ch;
            margin: 0
        }

        /* SIDEBAR */
        .side-card {
            background: #fff;
            border-radius: var(--r);
            box-shadow: var(--shadow-sm);
            border: 1px solid rgba(231,226,216,.7);
            overflow: hidden
        }

        .side-user {
            padding: 1.5rem 1.4rem;
            border-bottom: 1px solid var(--line);
            display: flex;
            align-items: center;
            gap: .9rem
        }

            .side-user .av {
                width: 52px;
                height: 52px;
                border-radius: 50%;
                background: var(--navy);
                color: #fff;
                display: grid;
                place-items: center;
                font-family: 'Sora';
                font-weight: 700;
                font-size: 1.15rem;
                flex: none
            }

            .side-user b {
                display: block;
                font-family: 'Sora';
                color: var(--navy);
                font-size: 1rem
            }

            .side-user span {
                font-size: .8rem;
                color: var(--muted);
                word-break: break-all
            }

        .side-menu {
            padding: .7rem
        }

        .side-link {
            display: flex;
            align-items: center;
            gap: .8rem;
            padding: .7rem .9rem;
            border-radius: 12px;
            color: var(--navy);
            font-weight: 500;
            font-size: .94rem;
            cursor: pointer;
            transition: .18s;
            margin-bottom: .15rem;
            border: none;
            background: none;
            width: 100%;
            text-align: left
        }

            .side-link svg {
                color: var(--muted);
                flex: none;
                transition: .18s
            }

            .side-link:hover {
                background: var(--cream)
            }

            .side-link.active {
                background: rgba(15,163,163,.1);
                color: var(--teal-dark);
                font-weight: 600
            }

                .side-link.active svg {
                    color: var(--teal-dark)
                }

        .side-sep {
            height: 1px;
            background: var(--line);
            margin: .5rem .5rem
        }

        .side-link.logout {
            color: #c0554f
        }

            .side-link.logout svg {
                color: #c0554f
            }

            .side-link.logout:hover {
                background: rgba(192,85,79,.08)
            }

        .side-sticky {
            position: sticky;
            top: 90px
        }

        .menu-btn-mobile {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: .85rem 1.1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            font-weight: 600;
            color: var(--navy);
            box-shadow: var(--shadow-sm);
            border: none;
            cursor: pointer
        }

        /* CONTENT */
        .pane {
            display: none
        }

            .pane.active {
                display: block;
                animation: fade .3s ease
            }

        @@keyframes fade {
            from {
                opacity: 0;
                transform: translateY(6px)
            }

            to {
                opacity: 1;
                transform: none
            }
        }

        .pane-head {
            margin-bottom: 1.4rem
        }

            .pane-head h1 {
                font-family: 'Sora';
                font-weight: 700;
                font-size: 1.6rem;
                color: var(--navy);
                margin-bottom: .3rem
            }

            .pane-head p {
                color: var(--muted);
                margin: 0
            }

        .card-soft {
            background: #fff;
            border-radius: var(--r);
            box-shadow: var(--shadow-sm);
            border: 1px solid rgba(231,226,216,.7);
            padding: 1.6rem
        }

        /* STAT CARDS */
        .stat-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: var(--shadow-sm);
            border: 1px solid rgba(231,226,216,.7);
            padding: 1.2rem 1.3rem;
            height: 100%
        }

            .stat-card .ico {
                width: 40px;
                height: 40px;
                border-radius: 11px;
                background: rgba(15,163,163,.1);
                color: var(--teal-dark);
                display: grid;
                place-items: center;
                margin-bottom: .7rem
            }

            .stat-card .num {
                font-family: 'Sora';
                font-weight: 800;
                font-size: 1.7rem;
                color: var(--navy);
                line-height: 1
            }

            .stat-card .lab {
                font-size: .84rem;
                color: var(--muted);
                margin-top: .2rem
            }

        /* UPCOMING FEATURE */
        .upcoming {
            position: relative;
            border-radius: var(--r);
            overflow: hidden;
            box-shadow: var(--shadow-md);
            color: #fff;
            min-height: 250px;
            display: flex;
            align-items: flex-end
        }

            .upcoming img {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                object-fit: cover
            }

            .upcoming::after {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient(115deg,rgba(14,42,59,.9) 0%,rgba(14,42,59,.55) 55%,rgba(11,127,128,.35) 100%)
            }

            .upcoming .inner {
                position: relative;
                z-index: 2;
                padding: 1.8rem
            }

        .up-badge {
            display: inline-block;
            background: rgba(255,255,255,.16);
            border: 1px solid rgba(255,255,255,.28);
            font-size: .72rem;
            font-weight: 600;
            padding: .3rem .75rem;
            border-radius: 999px;
            margin-bottom: .7rem;
            backdrop-filter: blur(4px)
        }

        .upcoming h3 {
            font-weight: 700;
            font-size: 1.4rem;
            margin: 0 0 .2rem
        }

        .upcoming .sub {
            color: rgba(255,255,255,.82);
            font-size: .9rem
        }

        .up-meta {
            display: flex;
            flex-wrap: wrap;
            gap: .6rem 1.4rem;
            margin: 1rem 0 1.2rem;
            font-size: .88rem;
            color: rgba(255,255,255,.92)
        }

            .up-meta b {
                color: #fff;
                font-family: 'Sora';
                font-weight: 600
            }

        .status-chip {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            font-size: .78rem;
            font-weight: 600;
            padding: .3rem .75rem;
            border-radius: 999px
        }

        .status-ok {
            background: rgba(15,163,163,.16);
            color: #8ce7e7;
            border: 1px solid rgba(143,231,231,.3)
        }

        .up-btns .btn-white {
            background: #fff;
            color: var(--navy);
            border: none;
            border-radius: 999px;
            font-weight: 600;
            padding: .6rem 1.2rem;
            font-size: .88rem;
            transition: .2s;
            text-decoration: none
        }

            .up-btns .btn-white:hover {
                background: var(--teal);
                color: #fff
            }

        .up-btns .btn-linewhite {
            background: transparent;
            color: #fff;
            border: 1px solid rgba(255,255,255,.5);
            border-radius: 999px;
            font-weight: 600;
            padding: .6rem 1.2rem;
            font-size: .88rem;
            transition: .2s;
            cursor: pointer
        }

            .up-btns .btn-linewhite:hover {
                background: #fff;
                color: var(--navy)
            }

        /* ACTIVITY */
        .act-item {
            display: flex;
            align-items: flex-start;
            gap: .85rem;
            padding: .85rem 0;
            border-top: 1px solid var(--line)
        }

            .act-item:first-child {
                border-top: none;
                padding-top: 0
            }

        .act-ico {
            flex: none;
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: var(--cream);
            display: grid;
            place-items: center;
            color: var(--teal-dark)
        }

        .act-item .t {
            color: var(--navy);
            font-size: .93rem
        }

        .act-item .time {
            color: var(--muted);
            font-size: .78rem;
            margin-top: .1rem
        }

        /* FORM */
        .field label {
            font-size: .8rem;
            font-weight: 600;
            color: var(--navy);
            margin-bottom: .35rem;
            display: block
        }

        .field input, .field select {
            width: 100%;
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: .7rem .9rem;
            font-size: .93rem;
            color: var(--navy);
            background: var(--cream);
            outline: none;
            transition: .2s
        }

            .field input:focus, .field select:focus {
                border-color: var(--teal);
                background: #fff;
                box-shadow: 0 0 0 3px rgba(15,163,163,.12)
            }

        /* TABS */
        .subtabs {
            display: inline-flex;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 999px;
            padding: .25rem;
            margin-bottom: 1.4rem
        }

        .subtab {
            border: none;
            background: none;
            border-radius: 999px;
            padding: .45rem 1.1rem;
            font-weight: 600;
            font-size: .88rem;
            color: var(--muted);
            cursor: pointer;
            transition: .2s
        }

            .subtab.active {
                background: var(--navy);
                color: #fff
            }

        /* BOOKING ROW CARD */
        .trip-card {
            display: flex;
            gap: 1.1rem;
            background: #fff;
            border-radius: 16px;
            box-shadow: var(--shadow-sm);
            border: 1px solid rgba(231,226,216,.7);
            padding: .9rem;
            margin-bottom: 1rem;
            align-items: center
        }

            .trip-card img {
                width: 120px;
                height: 92px;
                border-radius: 12px;
                object-fit: cover;
                flex: none
            }

        .trip-info {
            flex: 1;
            min-width: 0
        }

            .trip-info .country {
                font-size: .76rem;
                color: var(--teal-dark);
                font-weight: 600
            }

            .trip-info h4 {
                font-family: 'Sora';
                font-weight: 700;
                font-size: 1.05rem;
                color: var(--navy);
                margin: .1rem 0 .3rem
            }

            .trip-info .meta {
                font-size: .84rem;
                color: var(--muted);
                display: flex;
                flex-wrap: wrap;
                gap: .3rem 1rem
            }

            .trip-info .resno {
                font-size: .78rem;
                color: var(--muted);
                margin-top: .2rem
            }

        .trip-right {
            flex: none;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: .6rem
        }

        .badge-soft {
            font-size: .74rem;
            font-weight: 600;
            padding: .3rem .7rem;
            border-radius: 999px
        }

        .badge-ok {
            background: rgba(15,163,163,.12);
            color: var(--teal-dark)
        }

        .badge-done {
            background: rgba(14,42,59,.08);
            color: var(--navy)
        }

        .badge-wait {
            background: rgba(214,158,46,.15);
            color: #a9741a
        }

        .trip-right .acts {
            display: flex;
            gap: .4rem
        }

        .mini-btn {
            font-size: .8rem;
            font-weight: 600;
            padding: .4rem .8rem;
            border-radius: 999px;
            border: 1px solid var(--line);
            background: #fff;
            color: var(--navy);
            cursor: pointer;
            transition: .2s;
            text-decoration: none
        }

            .mini-btn:hover {
                border-color: var(--teal);
                color: var(--teal-dark)
            }

            .mini-btn.solid {
                background: var(--navy);
                color: #fff;
                border-color: var(--navy)
            }

                .mini-btn.solid:hover {
                    background: var(--teal-dark);
                    border-color: var(--teal-dark);
                    color: #fff
                }

        /* FAVORITE TOUR CARD */
        .tour-card {
            background: #fff;
            border-radius: var(--r);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            transition: .3s;
            height: 100%;
            display: flex;
            flex-direction: column;
            border: 1px solid rgba(231,226,216,.7);
        }

            .tour-card:hover {
                transform: translateY(-6px);
                box-shadow: var(--shadow-md)
            }

        .tour-media {
            position: relative;
            height: 180px;
            overflow: hidden
        }

            .tour-media img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: .5s
            }

        .tour-card:hover .tour-media img {
            transform: scale(1.07)
        }

        .fav {
            position: absolute;
            top: .7rem;
            right: .75rem;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(255,255,255,.94);
            display: grid;
            place-items: center;
            color: #e0575b;
            cursor: pointer;
            border: none;
            transition: .2s
        }

            .fav svg {
                fill: currentColor
            }

            .fav:hover {
                transform: scale(1.1)
            }

        .tour-body {
            padding: 1.05rem 1.15rem 1.2rem;
            display: flex;
            flex-direction: column;
            flex: 1
        }

        .tour-country {
            font-size: .76rem;
            color: var(--teal-dark);
            font-weight: 600
        }

        .tour-title {
            font-family: 'Sora';
            font-weight: 700;
            font-size: 1.05rem;
            margin: .15rem 0 .45rem;
            color: var(--navy)
        }

        .tour-meta {
            display: flex;
            align-items: center;
            gap: .8rem;
            font-size: .82rem;
            color: var(--muted);
            margin-bottom: .8rem
        }

        .tour-foot {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            margin-top: auto;
            padding-top: .5rem;
            border-top: 1px solid var(--line)
        }

        .price small {
            color: var(--muted);
            font-size: .72rem;
            display: block
        }

        .price b {
            font-family: 'Sora';
            font-size: 1.18rem;
            color: var(--navy)
        }

            .price b span {
                font-size: .82rem;
                font-weight: 600;
                color: var(--muted)
            }

        .btn-incele {
            background: var(--navy);
            color: #fff;
            border-radius: 999px;
            font-size: .82rem;
            font-weight: 600;
            padding: .5rem 1rem;
            border: none;
            transition: .25s;
            text-decoration: none
        }

            .btn-incele:hover {
                background: var(--teal-dark);
                color: #fff
            }

        /* REVIEWS & QUESTIONS & RATINGS */
        .rev-card, .q-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: var(--shadow-sm);
            border: 1px solid rgba(231,226,216,.7);
            padding: 1.3rem 1.4rem;
            margin-bottom: 1rem
        }

            .rev-card .top, .q-card .top {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                gap: 1rem;
                flex-wrap: wrap
            }

            .rev-card h4 {
                font-family: 'Sora';
                font-weight: 700;
                font-size: 1.05rem;
                color: var(--navy);
                margin: 0
            }

        .rev-stars {
            color: #f4a92c;
            font-size: .9rem
        }

            .rev-stars .off {
                color: #d8cfc0
            }

        .rev-date {
            font-size: .78rem;
            color: var(--muted)
        }

        .rev-card p {
            color: var(--navy);
            line-height: 1.6;
            margin: .7rem 0 .9rem;
            font-size: .93rem
        }

        .rev-acts {
            display: flex;
            gap: .5rem
        }

        .q-card .tour-name {
            font-size: .78rem;
            color: var(--teal-dark);
            font-weight: 600
        }

        .q-card .q-txt {
            font-family: 'Sora';
            font-weight: 600;
            color: var(--navy);
            margin: .35rem 0 .2rem;
            font-size: 1rem
        }

        .q-card .q-date {
            font-size: .78rem;
            color: var(--muted)
        }

        .q-answer {
            background: rgba(15,163,163,.06);
            border-radius: 12px;
            padding: .8rem 1rem;
            margin-top: .9rem;
            display: flex;
            gap: .7rem
        }

            .q-answer .who {
                font-family: 'Sora';
                font-weight: 700;
                color: var(--teal-dark);
                font-size: .82rem;
                white-space: nowrap
            }

            .q-answer .txt {
                color: var(--muted);
                font-size: .9rem;
                line-height: 1.55
            }

        .q-wait-note {
            color: var(--muted);
            font-size: .85rem;
            margin-top: .8rem;
            font-style: italic
        }

        .rate-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: var(--shadow-sm);
            border: 1px solid rgba(231,226,216,.7);
            padding: 1.2rem 1.3rem;
            height: 100%;
            display: flex;
            flex-direction: column
        }

            .rate-card .country {
                font-size: .76rem;
                color: var(--teal-dark);
                font-weight: 600
            }

            .rate-card h4 {
                font-family: 'Sora';
                font-weight: 700;
                font-size: 1.02rem;
                color: var(--navy);
                margin: .15rem 0 .5rem
            }

            .rate-card .stars {
                color: #f4a92c;
                font-size: 1.15rem;
                letter-spacing: 2px
            }

                .rate-card .stars .off {
                    color: #d8cfc0
                }

            .rate-card .score {
                font-family: 'Sora';
                font-weight: 600;
                color: var(--navy);
                font-size: .9rem;
                margin-top: .3rem
            }

            .rate-card .date {
                font-size: .76rem;
                color: var(--muted);
                margin-top: .15rem
            }

            .rate-card .mini-btn {
                margin-top: auto;
                align-self: flex-start
            }

        .empty {
            text-align: center;
            padding: 3rem 1rem
        }

            .empty .ico {
                width: 60px;
                height: 60px;
                border-radius: 16px;
                background: rgba(15,163,163,.1);
                color: var(--teal-dark);
                display: grid;
                place-items: center;
                margin: 0 auto 1rem
            }

            .empty h3 {
                font-family: 'Sora';
                font-weight: 700;
                color: var(--navy);
                font-size: 1.2rem
            }

            .empty p {
                color: var(--muted);
                margin: .3rem 0 1.2rem
            }

        /* TOAST */
        .toast-ok {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: var(--navy);
            color: #fff;
            padding: .9rem 1.3rem;
            border-radius: 14px;
            box-shadow: var(--shadow-md);
            font-size: .9rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: .6rem;
            z-index: 1080;
            opacity: 0;
            transform: translateY(12px);
            transition: .3s;
            pointer-events: none
        }

            .toast-ok.show {
                opacity: 1;
                transform: none
            }

            .toast-ok svg {
                color: #7fe3e3
            }

        .modal-content {
            border-radius: var(--r);
            border: none
        }

        .star-pick {
            font-size: 1.7rem;
            color: #d8cfc0;
            cursor: pointer;
            transition: .15s
        }

            .star-pick.on {
                color: #f4a92c
            }

        @@media(max-width:991px) {
            .side-sticky {
                position: static
            }
        }
    </style>
}

<!-- PAGE HEAD -->
<div class="container prof-head">
    <div class="crumb"><a href="/">@(isEn ? "Home" : "Ana Sayfa")</a> / <span class="cur">@(isEn ? "My Profile" : "Profilim")</span></div>
    <div class="eyebrow">@(isEn ? "My Account" : "Hesabım")</div>
    <h1>@(isEn ? "My Profile" : "Profilim")</h1>
    <p>@(isEn ? "Manage your travels, favorites, and overall Travelio experience from here." : "Seyahatlerini, favorilerini ve Travelio deneyimini buradan yönetebilirsin.")</p>
</div>

<div class="container pb-2">
    <!-- MOBILE MENU BUTTON -->
    <div class="d-lg-none mb-3">
        <button class="menu-btn-mobile" type="button" data-bs-toggle="offcanvas" data-bs-target="#accountMenu">
            <span>@(isEn ? "Account Menu" : "Hesap Menüsü")</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
        </button>
    </div>

    <div class="row g-4">
        <!-- SIDEBAR (DESKTOP) -->
        <div class="col-lg-3 d-none d-lg-block">
            <div class="side-sticky">
                <div class="side-card" id="sidebarDesktop"></div>
            </div>
        </div>

        <!-- CONTENT -->
        <div class="col-lg-9">

            <!-- 1. GENEL BAKIŞ (OVERVIEW) -->
            <div id="pane-overview" class="pane active">
                <div class="pane-head">
                    <h1>@(isEn ? $"Hello {ViewBag.UserName} 👋" : $"Merhaba {ViewBag.UserName} 👋")</h1>
                    <p>@(isEn ? "Explore your next adventure and manage your past bookings and favorites." : "Bir sonraki maceranın detaylarına göz atabilir, geçmiş seyahatlerini ve favorilerini yönetebilirsin.")</p>
                </div>
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-3">
                        <div class="stat-card">
                            <div class="ico">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h18v12H3z" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                            </div>
                            <div class="num">@upcomingTrips.Count</div>
                            <div class="lab">@(isEn ? "Upcoming Tour" : "Yaklaşan Tur")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-card">
                            <div class="ico">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
                            </div>
                            <div class="num">@completedTrips.Count</div>
                            <div class="lab">@(isEn ? "Completed Tour" : "Tamamlanan Tur")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-card">
                            <div class="ico">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z" /></svg>
                            </div>
                            <div class="num" id="statFavCount">4</div>
                            <div class="lab">@(isEn ? "Favorite Tour" : "Favori Tur")</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stat-card">
                            <div class="ico">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                            </div>
                            <div class="num">@(comments?.Count ?? 0)</div>
                            <div class="lab">@(isEn ? "Reviews" : "Yorum")</div>
                        </div>
                    </div>
                </div>

                @if (upcomingTrips.Any())
                {
                    var up = upcomingTrips.First();
                    <h2 style="font-family:'Sora';font-weight:700;font-size:1.25rem;color:var(--navy);margin-bottom:1rem">
                        @(isEn ? "Upcoming Journey" : "Yaklaşan Seyahatin")
                    </h2>
                    <div class="upcoming mb-4">
                        <img src="https://images.unsplash.com/photo-1541849546-216549ae216d?auto=format&fit=crop&w=800&q=80" alt="@up.TourTitle">
                        <div class="inner">
                            <span class="up-badge">@(isEn ? "Booking" : "Rezervasyon") #@up.Id.Substring(Math.Max(0, up.Id.Length - 6))</span>
                            <h3>@up.TourTitle</h3>
                            <div class="sub">@up.TotalParticipants @(isEn ? "Guests" : "Kişi")</div>
                            <div class="up-meta">
                                <span>📅 <b>@up.SelectedTourDate.ToString("dd.MM.yyyy")</b></span>
                                <span>💰 <b>@up.TotalPrice.ToString("N0") TL</b></span>
                                <span class="status-chip status-ok">● @up.Status</span>
                            </div>
                            <div class="up-btns d-flex gap-2 flex-wrap">
                                <a href="/Tour/Detail/@up.TourId" class="btn-white">@(isEn ? "Tour Details" : "Tur Detayı")</a>
                                <button type="button" class="btn-linewhite" onclick="go('trips')">@(isEn ? "View Booking" : "Rezervasyonu Gör")</button>
                            </div>
                        </div>
                    </div>
                }

                <div class="card-soft">
                    <h2 style="font-family:'Sora';font-weight:700;font-size:1.15rem;color:var(--navy);margin-bottom:1rem">
                        @(isEn ? "Recent Activities" : "Son Aktiviteler")
                    </h2>
                    <div class="act-item">
                        <div class="act-ico">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                        </div>
                        <div>
                            <div class="t">@(isEn ? "Your reviews are published on active tours." : "Onaylanan yorumların turlarda listeleniyor.")</div>
                            <div class="time">@(isEn ? "Active" : "Aktif")</div>
                        </div>
                    </div>
                    <div class="act-item">
                        <div class="act-ico">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h18v12H3z" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                        </div>
                        <div>
                            <div class="t">@(isEn ? "Your tour booking records have been synchronized." : "Tur rezervasyon kayıtların başarıyla senkronize edildi.")</div>
                            <div class="time">@(isEn ? "Recent" : "Yakın zamanda")</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. PROFİL BİLGİLERİM (PROFILE) -->
            <div id="pane-profile" class="pane">
                <div class="pane-head">
                    <h1>@(isEn ? "Personal Information" : "Profil Bilgilerim")</h1>
                    <p>@(isEn ? "Update your personal and contact details from here." : "Kişisel bilgilerini buradan güncelleyebilirsin.")</p>
                </div>

                @if (TempData["ProfileUpdateSuccess"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert" style="border-radius: 12px;">
                        ✓ @TempData["ProfileUpdateSuccess"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="card-soft">
                    <form method="post" asp-action="UpdateProfile" asp-controller="Profile">
                        <div class="row g-3">
                            <div class="col-md-6 field">
                                <label>@(isEn ? "Full Name" : "Ad Soyad")</label>
                                <input type="text" name="fullName" value="@ViewBag.UserName" required />
                            </div>
                            <div class="col-md-6 field">
                                <label>@(isEn ? "Email Address" : "E-posta")</label>
                                <input type="email" name="email" value="@ViewBag.UserEmail" required />
                            </div>
                            <div class="col-md-6 field">
                                <label>@(isEn ? "Phone Number" : "Telefon")</label>
                                <input type="text" name="phone" value="@ViewBag.UserPhone" />
                            </div>
                            <div class="col-md-6 field">
                                <label>@(isEn ? "Birth Date" : "Doğum Tarihi")</label>
                                <input type="date" value="2003-06-02" />
                            </div>
                            <div class="col-md-6 field">
                                <label>@(isEn ? "City" : "Şehir")</label>
                                <input type="text" name="city" value="İstanbul" />
                            </div>
                            <div class="col-md-6 field">
                                <label>@(isEn ? "Country" : "Ülke")</label>
                                <select>
                                    <option selected>Türkiye</option>
                                    <option>United Kingdom</option>
                                    <option>Germany</option>
                                    <option>Netherlands</option>
                                </select>
                            </div>
                        </div>
                        <button type="submit" class="btn-teal mt-4">
                            @(isEn ? "Update Information" : "Bilgileri Güncelle")
                        </button>
                    </form>
                </div>
            </div>

            <!-- 3. TURLARIM (TRIPS) -->
            <div id="pane-trips" class="pane">
                <div class="pane-head">
                    <h1>@(isEn ? "My Trips" : "Turlarım")</h1>
                    <p>@(isEn ? "All your upcoming and completed travels." : "Yaklaşan ve tamamlanan tüm seyahatlerin.")</p>
                </div>
                <div class="subtabs" role="tablist">
                    <button type="button" class="subtab active" onclick="tripFilter(this,'all')">@(isEn ? "All" : "Tümü")</button>
                    <button type="button" class="subtab" onclick="tripFilter(this,'upcoming')">@(isEn ? "Upcoming" : "Yaklaşan")</button>
                    <button type="button" class="subtab" onclick="tripFilter(this,'completed')">@(isEn ? "Completed" : "Tamamlanan")</button>
                </div>

                <div id="tripUpcoming">
                    <h3 style="font-family:'Sora';font-weight:600;font-size:.85rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:.9rem">
                        @(isEn ? "Upcoming" : "Yaklaşan")
                    </h3>
                    @if (upcomingTrips.Any())
                    {
                        foreach (var t in upcomingTrips)
                        {
                            <div class="trip-card">
                                <img src="https://images.unsplash.com/photo-1541849546-216549ae216d?auto=format&fit=crop&w=800&q=80" alt="@t.TourTitle">
                                <div class="trip-info">
                                    <div class="country">Travelio Tour</div>
                                    <h4>@t.TourTitle</h4>
                                    <div class="meta"><span>📅 @t.SelectedTourDate.ToString("dd.MM.yyyy")</span></div>
                                    <div class="resno">@(isEn ? "Booking" : "Rezervasyon"): #@t.Id.Substring(Math.Max(0, t.Id.Length - 6))</div>
                                </div>
                                <div class="trip-right">
                                    <span class="badge-soft badge-ok">@t.Status</span>
                                    <div class="acts">
                                        <a href="/Tour/Detail/@t.TourId" class="mini-btn">@(isEn ? "Tour Details" : "Tur Detayı")</a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted" style="font-size: .9rem;">@(isEn ? "No upcoming trips." : "Yaklaşan bir seyahatiniz bulunmuyor.")</p>
                    }
                </div>

                <div id="tripCompleted">
                    <h3 style="font-family:'Sora';font-weight:600;font-size:.85rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin:1.6rem 0 .9rem">
                        @(isEn ? "Completed" : "Tamamlanan")
                    </h3>
                    @if (completedTrips.Any())
                    {
                        foreach (var t in completedTrips)
                        {
                            <div class="trip-card">
                                <img src="https://images.unsplash.com/photo-1552832230-c0197dd311b5?auto=format&fit=crop&w=800&q=80" alt="@t.TourTitle">
                                <div class="trip-info">
                                    <div class="country">Travelio Tour</div>
                                    <h4>@t.TourTitle</h4>
                                    <div class="meta"><span>📅 @t.SelectedTourDate.ToString("dd.MM.yyyy")</span></div>
                                    <div class="resno">@(isEn ? "Booking" : "Rezervasyon"): #@t.Id.Substring(Math.Max(0, t.Id.Length - 6))</div>
                                </div>
                                <div class="trip-right">
                                    <span class="badge-soft badge-done">@(isEn ? "Completed" : "Tamamlandı")</span>
                                    <div class="acts">
                                        <a href="/Tour/Detail/@t.TourId" class="mini-btn">@(isEn ? "Tour Details" : "Tur Detayı")</a>
                                        <button type="button" class="mini-btn solid" onclick="go('reviews')">@(isEn ? "Write Review" : "Yorum Yap")</button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted" style="font-size: .9rem;">@(isEn ? "No completed trips yet." : "Henüz tamamlanan bir seyahatiniz bulunmuyor.")</p>
                    }
                </div>
            </div>

            <!-- 4. FAVORİLERİM (FAVORITES) -->
            <div id="pane-favorites" class="pane">
                <div class="pane-head">
                    <h1>@(isEn ? "My Favorites" : "Favorilerim")</h1>
                    <p>@(isEn ? "Tours saved to explore and review later." : "Daha sonra incelemek için kaydettiğin turlar.")</p>
                </div>
                <div class="row g-4" id="favGrid"></div>
            </div>

            <!-- 5. YORUMLARIM (REVIEWS) -->
            <div id="pane-reviews" class="pane">
                <div class="pane-head">
                    <h1>@(isEn ? "My Reviews" : "Yorumlarım")</h1>
                    <p>@(isEn ? "Experiences and reviews you shared across tours." : "Turlar hakkında paylaştığın değerlendirmeler.")</p>
                </div>
                <div id="reviewList">
                    @if (comments != null && comments.Any())
                    {
                        foreach (var r in comments)
                        {
                            <div class="rev-card" data-rev="@r.Id">
                                <div class="top">
                                    <div>
                                        <h4>Travelio Tur Deneyimi</h4>
                                        <span class="rev-date">@r.CreatedDate.ToString("dd MMMM yyyy")</span>
                                    </div>
                                    <span class="rev-stars">@string.Concat(Enumerable.Repeat("★", r.Rating))</span>
                                </div>
                                <p>@r.Content</p>
                                <div class="rev-acts">
                                    <button type="button" class="mini-btn" onclick="toast('@(isEn ? "Editing active in demo mode." : "Düzenleme demo modunda çalışıyor.")')">@(isEn ? "Edit" : "Düzenle")</button>
                                    <button type="button" class="mini-btn" onclick="askDeleteReview('@r.Id')">@(isEn ? "Delete" : "Sil")</button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="card-soft">
                            <div class="empty">
                                <div class="ico">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                                </div>
                                <h3>@(isEn ? "You don't have any reviews yet." : "Henüz yorumun yok.")</h3>
                                <p>@(isEn ? "Share your authentic experience on tours you attended." : "Tamamladığın turlar hakkında deneyimini paylaşabilirsin.")</p>
                                <button type="button" class="btn-teal" onclick="go('trips')">@(isEn ? "Go to My Trips" : "Turlarıma Git")</button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- 6. SORULARIM (QUESTIONS) -->
            <div id="pane-questions" class="pane">
                <div class="pane-head">
                    <h1>@(isEn ? "My Questions" : "Sorularım")</h1>
                    <p>@(isEn ? "Questions asked on tour detail pages and responses." : "Tur detay sayfalarında sorduğun sorular ve yanıtları.")</p>
                </div>
                @if (questions != null && questions.Any())
                {
                    foreach (var q in questions)
                    {
                        <div class="q-card">
                            <div class="top">
                                <div>
                                    <div class="tour-name">Travelio Tour Inquiries</div>
                                    <div class="q-txt">@q.QuestionText</div>
                                    <div class="q-date">@q.AskedDate.ToString("dd MMMM yyyy")</div>
                                </div>
                                <span class="badge-soft @(q.IsAnswered ? "badge-ok" : "badge-wait")">
                                    @(q.IsAnswered ? (isEn ? "Answered" : "Cevaplandı") : (isEn ? "Awaiting Reply" : "Cevap Bekliyor"))
                                </span>
                            </div>
                            @if (q.IsAnswered)
                            {
                                <div class="q-answer">
                                    <span class="who">Travelio:</span>
                                    <span class="txt">@q.AnswerText</span>
                                </div>
                            }
                            else
                            {
                                <div class="q-wait-note">@(isEn ? "Our team will reply to your question shortly." : "Ekibimiz sorunu en kısa sürede yanıtlayacak.")</div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="card-soft">
                        <div class="empty">
                            <div class="ico">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3" /><line x1="12" y1="17" x2="12" y2="17" /></svg>
                            </div>
                            <h3>@(isEn ? "No questions asked yet." : "Henüz iletilen bir sorun yok.")</h3>
                            <p>@(isEn ? "Ask questions about itineraries anytime from the tour detail pages." : "Tur detay sayfalarından rehberlerimize aklına takılanları sorabilirsin.")</p>
                        </div>
                    </div>
                }
            </div>

            <!-- 7. DEĞERLENDİRMELERİM (RATINGS) -->
            <div id="pane-ratings" class="pane">
                <div class="pane-head">
                    <h1>@(isEn ? "My Ratings" : "Değerlendirmelerim")</h1>
                    <p>@(isEn ? "Ratings given to tours you attended." : "Katıldığın turlara verdiğin puanlar.")</p>
                </div>
                <div class="row g-3" id="rateGrid"></div>
            </div>

        </div>
    </div>
</div>

<!-- OFFCANVAS (MOBILE MENU) -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="accountMenu" style="width:300px;background:var(--cream)">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" style="font-family:'Sora';font-weight:700;color:var(--navy)">@(isEn ? "Account Menu" : "Hesap Menüsü")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-2">
        <div class="side-card" id="sidebarMobile"></div>
    </div>
</div>

<!-- LOGOUT MODAL -->
<div class="modal fade" id="logoutModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center p-4">
                <div style="width:56px;height:56px;border-radius:16px;background:rgba(192,85,79,.1);color:#c0554f;display:grid;place-items:center;margin:0 auto 1rem">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                </div>
                <h5 style="font-family:'Sora';font-weight:700;color:var(--navy)">@(isEn ? "Are you sure you want to sign out?" : "Çıkış yapmak istediğine emin misin?")</h5>
                <p style="color:var(--muted);font-size:.9rem">@(isEn ? "Your saved bookings and preferences remain safe." : "Hesabından çıkış yapıldığında rezervasyonların ve favorilerin güvende kalır.")</p>
                <div class="d-flex gap-2 justify-content-center mt-3">
                    <button type="button" class="btn-outline" data-bs-dismiss="modal">@(isEn ? "Cancel" : "Vazgeç")</button>
                    <a href="/Account/Logout" class="btn-teal" style="background:#c0554f;text-decoration:none">@(isEn ? "Sign Out" : "Çıkış Yap")</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- RATING MODAL -->
<div class="modal fade" id="rateModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title" style="font-family:'Sora';font-weight:700;color:var(--navy)">@(isEn ? "Update Rating" : "Değerlendirmeyi Güncelle")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="rateTourName" style="color:var(--muted);font-size:.9rem;margin-bottom:.6rem"></p>
                <div id="ratePicker">
                    <span class="star-pick" data-v="1">★</span><span class="star-pick" data-v="2">★</span><span class="star-pick" data-v="3">★</span><span class="star-pick" data-v="4">★</span><span class="star-pick" data-v="5">★</span>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn-teal" onclick="saveRating()">@(isEn ? "Save" : "Kaydet")</button>
            </div>
        </div>
    </div>
</div>

<!-- DELETE REVIEW MODAL -->
<div class="modal fade" id="delModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center p-4">
                <h5 style="font-family:'Sora';font-weight:700;color:var(--navy)">@(isEn ? "Do you want to delete this review?" : "Yorumu silmek istiyor musun?")</h5>
                <p style="color:var(--muted);font-size:.9rem">@(isEn ? "This action cannot be undone." : "Bu işlem geri alınamaz.")</p>
                <div class="d-flex gap-2 justify-content-center mt-3">
                    <button type="button" class="btn-outline" data-bs-dismiss="modal">@(isEn ? "Cancel" : "Vazgeç")</button>
                    <button type="button" class="btn-teal" style="background:#c0554f" onclick="confirmDeleteReview()">@(isEn ? "Delete" : "Sil")</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- TOAST -->
<div class="toast-ok" id="toast">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
    <span id="toastMsg">@(isEn ? "Saved." : "Kaydedildi.")</span>
</div>

@section Scripts {
    <script>
        const isEn = @(isEn ? "true" : "false");

        const IC = {
          overview:'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>',
          profile:'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>',
          trips:'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h18v12H3z"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>',
          fav:'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>',
          reviews:'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',
          questions:'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12" y2="17"/></svg>',
          ratings:'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15 8.5 22 9.3 17 14 18.2 21 12 17.6 5.8 21 7 14 2 9.3 9 8.5 12 2"/></svg>',
          logout:'<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>'
        };

        const MENU = [
          {id:"overview", label: isEn ? "Overview" : "Genel Bakış", ic:"overview"},
          {id:"profile", label: isEn ? "Personal Info" : "Profil Bilgilerim", ic:"profile"},
          {id:"trips", label: isEn ? "My Trips" : "Turlarım", ic:"trips"},
          {id:"favorites", label: isEn ? "Favorites" : "Favorilerim", ic:"fav"},
          {id:"reviews", label: isEn ? "My Reviews" : "Yorumlarım", ic:"reviews"},
          {id:"questions", label: isEn ? "My Questions" : "Sorularım", ic:"questions"},
          {id:"ratings", label: isEn ? "My Ratings" : "Değerlendirmelerim", ic:"ratings"}
        ];

        let FAVORITES = [
          {title:"Tokyo & Kyoto", country:"Japonya", dur:"8 Gün / 7 Gece", rating:4.8, price:"79.900", img:"https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?auto=format&fit=crop&w=800&q=80"},
          {title:"İsviçre Alpleri", country:"İsviçre", dur:"7 Gün / 6 Gece", rating:5.0, price:"58.200", img:"https://images.unsplash.com/photo-1531366936337-7c912a4589a7?auto=format&fit=crop&w=800&q=80"},
          {title:"Kuzey Işıkları Norveç", country:"Norveç", dur:"6 Gün / 5 Gece", rating:4.9, price:"64.900", img:"https://images.unsplash.com/photo-1483347756197-71ef80e95f73?auto=format&fit=crop&w=800&q=80"},
          {title:"Paris & Alsace", country:"Fransa", dur:"7 Gün / 6 Gece", rating:4.8, price:"47.900", img:"https://images.unsplash.com/photo-1499856871958-5b9627545d1a?auto=format&fit=crop&w=800&q=80"}
        ];

        let RATINGS = [
          {title:"Roma & Toskana Keşfi", country:"İtalya", stars:5, date:"12 Haziran 2026"},
          {title:"Paris & Disneyland", country:"Fransa", stars:5, date:"18 Mart 2026"},
          {title:"Amsterdam Kanalları", country:"Hollanda", stars:4, date:"16 Kasım 2025"}
        ];

        function starStr(n){ let s=""; for(let i=1;i<=5;i++) s+= i<=n?"★":"<span class='off'>★</span>"; return s; }
        function toast(msg){ const t=document.getElementById("toast"); document.getElementById("toastMsg").textContent=msg; t.classList.add("show"); setTimeout(()=>t.classList.remove("show"),2600); }

        function buildSidebar(){
          const av = "@(ViewBag.UserName != null && ((string)ViewBag.UserName).Length >= 2 ? ((string)ViewBag.UserName).Substring(0, 2).ToUpper() : "TR")";
          return `
          <div class="side-user">
            <div class="av">${av}</div>
            <div style="min-width:0"><b>@ViewBag.UserName</b><span>@ViewBag.UserEmail</span></div>
          </div>
          <div class="side-menu">
            ${MENU.map(m=>`<button class="side-link" data-pane="${m.id}" onclick="go('${m.id}')">${IC[m.ic]}${m.label}</button>`).join("")}
            <div class="side-sep"></div>
            <button class="side-link logout" data-bs-toggle="modal" data-bs-target="#logoutModal">${IC.logout} ${isEn ? "Sign Out" : "Çıkış Yap"}</button>
          </div>`;
        }

        document.getElementById("sidebarDesktop").innerHTML = buildSidebar();
        document.getElementById("sidebarMobile").innerHTML = buildSidebar();

        function go(id){
          document.querySelectorAll(".pane").forEach(p=> p.classList.remove("active"));
          document.querySelectorAll(".side-link[data-pane]").forEach(b=> b.classList.toggle("active", b.dataset.pane===id));

          const target = document.getElementById("pane-" + id);
          if(target) target.classList.add("active");

          const oc = document.getElementById("accountMenu");
          if(window.bootstrap && bootstrap.Offcanvas){
            const inst = bootstrap.Offcanvas.getInstance(oc);
            if(inst) inst.hide();
          }
          window.scrollTo({top:0, behavior:"smooth"});

          if(id === "favorites") renderFavorites();
          if(id === "ratings") renderRatings();
        }

        function tripFilter(btn, type){
          document.querySelectorAll(".subtab").forEach(b=>b.classList.remove("active"));
          btn.classList.add("active");
          document.getElementById("tripUpcoming").style.display = (type==="completed")?"none":"block";
          document.getElementById("tripCompleted").style.display = (type==="upcoming")?"none":"block";
        }

        function renderFavorites(){
          const grid = document.getElementById("favGrid");
          document.getElementById("statFavCount").textContent = FAVORITES.length;
          if(FAVORITES.length === 0){
            grid.innerHTML = `
              <div class="col-12">
                <div class="card-soft"><div class="empty">
                  <div class="ico">${IC.fav}</div>
                  <h3>${isEn ? "No favorite tours yet." : "Henüz favori turun yok."}</h3>
                  <p>${isEn ? "How about discovering new routes?" : "Yeni rotalar keşfetmeye ne dersin?"}</p>
                  <a href="/Tour/Index" class="btn-teal">${isEn ? "Explore Tours" : "Turları Keşfet"}</a>
                </div></div>
              </div>`;
            return;
          }
          grid.innerHTML = FAVORITES.map((t,i)=>`
            <div class="col-sm-6 col-lg-4" data-fav="${i}">
              <article class="tour-card">
                <div class="tour-media">
                  <img src="${t.img}" alt="${t.title}">
                  <button class="fav" title="${isEn ? "Remove from favorites" : "Favoriden kaldır"}" onclick="removeFav(${i})">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
                  </button>
                </div>
                <div class="tour-body">
                  <div class="tour-country">${t.country}</div>
                  <h3 class="tour-title">${t.title}</h3>
                  <div class="tour-meta"><span>🗓️ ${t.dur}</span><span><span style="color:#f4a92c">★</span> ${t.rating.toFixed(1)}</span></div>
                  <div class="tour-foot">
                    <div class="price"><small>${isEn ? "Per person" : "Kişi başı"}</small><b>${t.price} <span>TL</span></b></div>
                    <a href="/Tour/Index" class="btn-incele">${isEn ? "View Tour" : "Turu İncele"}</a>
                  </div>
                </div>
              </article>
            </div>`).join("");
        }

        function removeFav(i){
          FAVORITES.splice(i,1);
          renderFavorites();
          toast(isEn ? "Removed from favorites." : "Favorilerden kaldırıldı.");
        }

        let pendingDelId = null;
        function askDeleteReview(id){
          pendingDelId = id;
          new bootstrap.Modal(document.getElementById("delModal")).show();
        }

        function confirmDeleteReview(){
          const card = document.querySelector(`.rev-card[data-rev="${pendingDelId}"]`);
          if(card) card.remove();
          bootstrap.Modal.getInstance(document.getElementById("delModal")).hide();
          toast(isEn ? "Review deleted." : "Yorum silindi.");
        }

        function renderRatings(){
          const grid = document.getElementById("rateGrid");
          grid.innerHTML = RATINGS.map((r,i)=>`
            <div class="col-sm-6 col-lg-4">
              <div class="rate-card">
                <div class="country">${r.country}</div>
                <h4>${r.title}</h4>
                <div class="stars" data-stars="${i}">${starStr(r.stars)}</div>
                <div class="score">${r.stars} / 5</div>
                <div class="date">${r.date}</div>
                <button class="mini-btn mt-3" type="button" onclick="openRatingModal(${i})">${isEn ? "Update Rating" : "Değerlendirmeyi Güncelle"}</button>
              </div>
            </div>`).join("");
        }

        let rateIndex = null, ratePicked = 0;
        function openRatingModal(i){
          rateIndex = i;
          ratePicked = RATINGS[i].stars;
          document.getElementById("rateTourName").textContent = RATINGS[i].title;
          paintPicker();
          new bootstrap.Modal(document.getElementById("rateModal")).show();
        }

        function paintPicker(){
          document.querySelectorAll("#ratePicker .star-pick").forEach(s=> s.classList.toggle("on", +s.dataset.v <= ratePicked));
        }

        document.querySelectorAll("#ratePicker .star-pick").forEach(s=>{
          s.addEventListener("click", ()=>{ ratePicked = +s.dataset.v; paintPicker(); });
        });

        function saveRating(){
          if(rateIndex === null) return;
          RATINGS[rateIndex].stars = ratePicked;
          bootstrap.Modal.getInstance(document.getElementById("rateModal")).hide();
          renderRatings();
          toast(isEn ? "Rating updated." : "Değerlendirmen güncellendi.");
        }

        // Başlangıç çalıştırması
        go("overview");
    </script>
}