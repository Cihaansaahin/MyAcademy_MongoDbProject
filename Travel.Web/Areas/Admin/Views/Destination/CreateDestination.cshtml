@model Travel.Web.DTOs.DestinationDtos.CreateDestinationDto
@{
    var isEn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLower() == "en";
    ViewData["Title"] = isEn ? "Add New Destination" : "Yeni Destinasyon Ekle";
}

@section Styles {
    <style>
        :root {
            --navy: #0e2a3b;
            --navy-2: #12384c;
            --navy-3: #1b455c;
            --teal: #0fa3a3;
            --teal-dark: #0b7f80;
            --cream: #f7f5f0;
            --bg: #f4f5f4;
            --white: #fff;
            --ink: #0e2a3b;
            --muted: #6a7c88;
            --line: #e7e2d8;
            --line-2: #eef0ef;
            --shadow-sm: 0 4px 18px rgba(14,42,59,.06);
            --shadow-md: 0 18px 50px rgba(14,42,59,.12);
            --r: 16px;
            --ok-bg: #e3f4f0;
            --ok-fg: #0b7f80;
            --cancel-bg: #f6e4e2;
            --cancel-fg: #b45a4f;
        }

        .crumb {
            font-size: .8rem;
            color: var(--muted);
            margin-bottom: .4rem
        }

            .crumb a {
                color: var(--muted);
                text-decoration: none
            }

                .crumb a:hover {
                    color: var(--teal-dark)
                }

            .crumb .cur {
                color: var(--navy);
                font-weight: 600
            }

        .page-intro {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 1.5rem
        }

            .page-intro h1 {
                font-weight: 700;
                font-size: 1.7rem;
                color: var(--navy);
                margin: .15rem 0 .3rem
            }

            .page-intro p {
                color: var(--muted);
                margin: 0;
                font-size: .94rem;
                max-width: 64ch
            }

        .btn-teal {
            background: var(--teal);
            color: #fff;
            border: none;
            border-radius: 999px;
            font-weight: 600;
            padding: .7rem 1.3rem;
            font-size: .9rem;
            transition: .25s;
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            white-space: nowrap;
            cursor: pointer
        }

            .btn-teal:hover {
                background: var(--teal-dark);
                color: #fff;
                box-shadow: 0 12px 26px rgba(15,163,163,.3)
            }

        .btn-ghost {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 999px;
            font-weight: 600;
            padding: .65rem 1.2rem;
            font-size: .88rem;
            color: var(--navy);
            transition: .2s;
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            white-space: nowrap;
            cursor: pointer;
            text-decoration: none
        }

            .btn-ghost:hover {
                border-color: var(--teal);
                color: var(--teal-dark)
            }

        /* SECTION CARD */
        .sec {
            background: #fff;
            border: 1px solid var(--line-2);
            border-radius: var(--r);
            box-shadow: var(--shadow-sm);
            padding: 1.5rem 1.6rem;
            margin-bottom: 1.3rem
        }

        .sec-head {
            margin-bottom: 1.2rem
        }

            .sec-head h2 {
                font-family: 'Sora';
                font-weight: 700;
                font-size: 1.12rem;
                color: var(--navy);
                margin: 0;
                display: flex;
                align-items: center;
                gap: .6rem
            }

            .sec-head .sec-ic {
                width: 32px;
                height: 32px;
                border-radius: 9px;
                background: rgba(15,163,163,.1);
                color: var(--teal-dark);
                display: grid;
                place-items: center;
                flex: none
            }

            .sec-head p {
                color: var(--muted);
                font-size: .86rem;
                margin: .4rem 0 0
            }

        /* FIELDS */
        .field {
            margin-bottom: 1rem
        }

            .field label {
                display: block;
                font-size: .8rem;
                font-weight: 600;
                color: var(--navy);
                margin-bottom: .35rem
            }

                .field label .req {
                    color: var(--cancel-fg)
                }

        .ctrl {
            width: 100%;
            border: 1px solid var(--line);
            background: var(--cream);
            border-radius: 11px;
            padding: .68rem .9rem;
            font-size: .9rem;
            color: var(--navy);
            outline: none;
            transition: .2s;
            font-family: inherit
        }

            .ctrl::placeholder {
                color: #a7b2ba
            }

            .ctrl:focus {
                border-color: var(--teal);
                background: #fff;
                box-shadow: 0 0 0 3px rgba(15,163,163,.12)
            }

        /* UPLOAD & PREVIEW */
        .upload {
            border: 1.5px dashed var(--line);
            border-radius: 14px;
            padding: 1.6rem 1rem;
            text-align: center;
            background: var(--cream);
            cursor: pointer;
            transition: .2s;
            display: block
        }

            .upload:hover {
                border-color: var(--teal);
                background: rgba(15,163,163,.04)
            }

            .upload .uic {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background: #fff;
                border: 1px solid var(--line);
                color: var(--teal-dark);
                display: grid;
                place-items: center;
                margin: 0 auto .6rem
            }

            .upload b {
                font-family: 'Sora';
                font-size: .9rem;
                color: var(--navy);
                display: block
            }

            .upload span {
                font-size: .78rem;
                color: var(--muted)
            }

        .cover-preview {
            margin-top: .9rem;
            border-radius: 12px;
            overflow: hidden;
            max-width: 280px;
            border: 1px solid var(--line)
        }

            .cover-preview img {
                width: 100%;
                display: block
            }

        /* STATUS PILLS */
        .status-pills {
            display: flex;
            gap: .6rem;
            flex-wrap: wrap
        }

        .status-pill {
            flex: 1;
            min-width: 140px;
            border: 1px solid var(--line);
            border-radius: 11px;
            padding: .7rem .9rem;
            cursor: pointer;
            transition: .2s;
            background: var(--cream)
        }

            .status-pill:hover {
                border-color: var(--teal)
            }

            .status-pill.sel {
                border-color: var(--teal);
                background: rgba(15,163,163,.06);
                box-shadow: 0 0 0 2px rgba(15,163,163,.12)
            }

            .status-pill b {
                font-family: 'Sora';
                font-size: .9rem;
                color: var(--navy);
                display: block
            }

            .status-pill span {
                font-size: .76rem;
                color: var(--muted)
            }

            .status-pill input {
                display: none
            }

        /* ACTION BAR */
        .action-bar {
            position: sticky;
            bottom: 0;
            background: rgba(255,255,255,.92);
            backdrop-filter: blur(10px);
            border: 1px solid var(--line-2);
            border-radius: 14px;
            box-shadow: var(--shadow-md);
            padding: .9rem 1.2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
            margin-top: .4rem;
            margin-bottom: .4rem;
            z-index: 100
        }

            .action-bar .saved {
                font-size: .83rem;
                color: var(--muted);
                display: flex;
                align-items: center;
                gap: .5rem
            }

            .action-bar .btns {
                display: flex;
                gap: .6rem;
                flex-wrap: wrap
            }
    </style>
}

<div class="crumb">
    <a href="/Admin/Dashboard">Dashboard</a> / <a href="/Admin/Destination/Index">@(isEn ? "Destinations" : "Destinasyonlar")</a> / <span class="cur">@(isEn ? "Add Destination" : "Yeni Destinasyon Ekle")</span>
</div>
<div class="page-intro">
    <div>
        <div class="eyebrow">@(isEn ? "Catalog Management" : "Katalog Yönetimi")</div>
        <h1>@(isEn ? "Add New Destination" : "Yeni Destinasyon Ekle")</h1>
        <p>@(isEn ? "Save a new city or country route destination in the platform." : "Sisteme yeni bir şehir veya ülke rotası kaydedin.")</p>
    </div>
    <a href="/Admin/Destination/Index" class="btn-ghost">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
        @(isEn ? "Back to Destinations" : "Destinasyonlara Dön")
    </a>
</div>

<form asp-area="Admin" asp-controller="Destination" asp-action="CreateDestination" method="post" id="destForm" enctype="multipart/form-data">
    <div class="sec">
        <div class="sec-head">
            <h2>
                <span class="sec-ic">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
                </span>
                @(isEn ? "Destination Details" : "Destinasyon Bilgileri")
            </h2>
            <p>@(isEn ? "Enter location geographic labels and featured media settings." : "Destinasyon konum bilgilerini ve kapak görselini belirleyin.")</p>
        </div>

        <div class="row g-3">
            <div class="col-md-6 field">
                <label>@(isEn ? "City" : "Şehir") <span class="req">*</span></label>
                <input class="ctrl" asp-for="City" placeholder="Örn: Roma" required>
            </div>

            <div class="col-md-6 field">
                <label>@(isEn ? "Country" : "Ülke") <span class="req">*</span></label>
                <input class="ctrl" asp-for="Country" placeholder="Örn: İtalya" required>
            </div>

            <!-- GÖRSEL YÜKLEME VE URL GİRİŞİ -->
            <div class="col-12 field">
                <label>@(isEn ? "Cover Image" : "Destinasyon Görseli") <span class="req">*</span></label>
                <label class="upload" for="destImgInput">
                    <div class="uic">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                    </div>
                    <b>@(isEn ? "Drag destination photo here or browse" : "Destinasyon görselini buraya sürükleyin veya seçin.")</b>
                    <span>JPG, PNG · Önerilen 1200x800</span>
                </label>
                <input type="file" id="destImgInput" accept="image/*" style="display:none" onchange="previewImg(this)">

                <div class="cover-preview" id="coverPreview" style="display:none">
                    <img id="coverImg" alt="Preview">
                </div>

                <div class="mt-2">
                    <label style="font-size:.76rem;color:var(--muted);font-weight:600">@(isEn ? "Or enter Image URL directly:" : "Veya doğrudan Görsel URL'si girin:")</label>
                    <input class="ctrl" asp-for="ImageUrl" id="tImgUrl" placeholder="https://images.unsplash.com/..." oninput="previewUrl(this.value)">
                </div>
            </div>

            <!-- POPÜLERLİK DURUM HAPLARI -->
            <div class="col-12 field mt-2">
                <label>@(isEn ? "Popularity Status" : "Popülerlik Durumu")</label>
                <div class="status-pills">
                    <label class="status-pill sel" data-popular="true">
                        <input type="radio" name="IsPopular" value="true" checked>
                        <b>@(isEn ? "Popular Destination" : "Popüler Destinasyon")</b>
                        <span>@(isEn ? "Showcase in top destinations" : "Ana sayfada ve aramalarda öne çıkar")</span>
                    </label>
                    <label class="status-pill" data-popular="false">
                        <input type="radio" name="IsPopular" value="false">
                        <b>@(isEn ? "Standard Route" : "Standart Rota")</b>
                        <span>@(isEn ? "Standard catalog listing" : "Normal katalog listelemesi")</span>
                    </label>
                </div>
            </div>
        </div>
    </div>

    <!-- ACTION BAR -->
    <div class="action-bar">
        <div class="saved">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
            @(isEn ? "Ready to save" : "Kaydedilmeye hazır")
        </div>
        <div class="btns">
            <a href="/Admin/Destination/Index" class="btn-ghost">@(isEn ? "Cancel" : "Vazgeç")</a>
            <button type="submit" class="btn-teal">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                @(isEn ? "Save Destination" : "Destinasyonu Kaydet")
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        /* ---------- STATUS PILLS ---------- */
        document.querySelectorAll(".status-pill").forEach(p => {
            p.addEventListener("click", () => {
                document.querySelectorAll(".status-pill").forEach(x => x.classList.remove("sel"));
                p.classList.add("sel");
                p.querySelector("input").checked = true;
            });
        });

        /* ---------- GÖRSEL ÖNİZLEME ---------- */
        function previewImg(inp) {
            if (!inp.files || !inp.files[0]) return;
            const url = URL.createObjectURL(inp.files[0]);
            document.getElementById("coverImg").src = url;
            document.getElementById("coverPreview").style.display = "block";
        }

        function previewUrl(url) {
            if (!url || !url.trim()) return;
            document.getElementById("coverImg").src = url.trim();
            document.getElementById("coverPreview").style.display = "block";
        }
    </script>
}