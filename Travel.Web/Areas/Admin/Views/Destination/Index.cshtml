@model List<Travel.Web.DTOs.DestinationDtos.ResultDestinationDto>
@{
    var isEn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLower() == "en";
    ViewData["Title"] = L["Destinasyon Yönetimi"].Value;

    var totalDest = Model?.Count ?? 0;
    var popularDest = Model?.Count(x => x.IsPopular) ?? 0;
    var standardDest = totalDest - popularDest;
    var uniqueCountries = Model?.Select(x => x.Country).Distinct().Count() ?? 0;
}

@section Styles {
    <style>
        :root {
            --navy: #0e2a3b;
            --navy-2: #12384c;
            --navy-3: #1b455c;
            --teal: #0fa3a3;
            --teal-dark: #0b7f80;
            --cream: #f7f5f0;
            --bg: #f4f5f4;
            --white: #fff;
            --ink: #0e2a3b;
            --muted: #6a7c88;
            --line: #e7e2d8;
            --line-2: #eef0ef;
            --shadow-sm: 0 4px 18px rgba(14,42,59,.06);
            --shadow-md: 0 18px 50px rgba(14,42,59,.12);
            --r: 16px;
            --ok-bg: #e3f4f0;
            --ok-fg: #0b7f80;
            --cancel-bg: #f6e4e2;
            --cancel-fg: #b45a4f;
        }

        .eyebrow {
            font-family: 'Sora',sans-serif;
            text-transform: uppercase;
            letter-spacing: .2em;
            font-size: .7rem;
            font-weight: 700;
            color: var(--teal-dark)
        }

        .page-intro {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 1.5rem
        }

            .page-intro h1 {
                font-weight: 700;
                font-size: 1.7rem;
                color: var(--navy);
                margin: .15rem 0 .3rem
            }

            .page-intro p {
                color: var(--muted);
                margin: 0;
                font-size: .94rem;
                max-width: 64ch
            }

        .btn-teal {
            background: var(--teal);
            color: #fff;
            border: none;
            border-radius: 999px;
            font-weight: 600;
            padding: .7rem 1.3rem;
            font-size: .9rem;
            transition: .25s;
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            white-space: nowrap;
            text-decoration: none
        }

            .btn-teal:hover {
                background: var(--teal-dark);
                color: #fff;
                box-shadow: 0 12px 26px rgba(15,163,163,.3)
            }

        /* KPI mini */
        .kpi {
            background: #fff;
            border: 1px solid var(--line-2);
            border-radius: var(--r);
            box-shadow: var(--shadow-sm);
            padding: 1rem 1.1rem;
            height: 100%;
            display: flex;
            align-items: center;
            gap: .85rem
        }

            .kpi .ic {
                width: 42px;
                height: 42px;
                border-radius: 11px;
                display: grid;
                place-items: center;
                background: rgba(15,163,163,.1);
                color: var(--teal-dark);
                flex: none
            }

                .kpi .ic.ok {
                    background: rgba(16,185,129,.12);
                    color: #10b981
                }

                .kpi .ic.gray {
                    background: rgba(106,124,136,.12);
                    color: var(--muted)
                }

            .kpi .num {
                font-family: 'Sora';
                font-weight: 800;
                font-size: 1.4rem;
                color: var(--navy);
                line-height: 1
            }

            .kpi .lab {
                font-size: .82rem;
                color: var(--muted);
                margin-top: .15rem
            }

        /* FILTER BAR */
        .card-x {
            background: #fff;
            border: 1px solid var(--line-2);
            border-radius: var(--r);
            box-shadow: var(--shadow-sm)
        }

        .filter-bar {
            padding: 1rem 1.1rem
        }

        .f-search {
            position: relative
        }

            .f-search svg {
                position: absolute;
                left: .85rem;
                top: 50%;
                transform: translateY(-50%);
                color: var(--muted)
            }

            .f-search input {
                width: 100%;
                border: 1px solid var(--line);
                background: var(--cream);
                border-radius: 11px;
                padding: .62rem .9rem .62rem 2.3rem;
                font-size: .9rem;
                outline: none;
                color: var(--navy)
            }

                .f-search input:focus {
                    border-color: var(--teal);
                    background: #fff;
                    box-shadow: 0 0 0 3px rgba(15,163,163,.1)
                }

        .f-select {
            width: 100%;
            border: 1px solid var(--line);
            background: #fff;
            border-radius: 11px;
            padding: .62rem 2rem .62rem .9rem;
            font-size: .88rem;
            font-weight: 500;
            color: var(--navy);
            outline: none;
            cursor: pointer
        }

            .f-select:focus {
                border-color: var(--teal)
            }

        .btn-clear {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 11px;
            padding: .62rem 1rem;
            font-size: .86rem;
            font-weight: 600;
            color: var(--muted);
            cursor: pointer;
            transition: .2s;
            white-space: nowrap;
            width: 100%;
            text-decoration: none;
            display: inline-block;
            text-align: center
        }

            .btn-clear:hover {
                border-color: var(--cancel-fg);
                color: var(--cancel-fg)
            }

        .result-line {
            font-size: .86rem;
            color: var(--muted);
            margin: .2rem 0 1rem;
            padding: 0 .2rem
        }

            .result-line b {
                color: var(--navy);
                font-weight: 600
            }

        /* TABLE */
        .tbl-wrap {
            overflow-x: auto
        }

        table.tx {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            min-width: 760px
        }

            table.tx th {
                font-size: .74rem;
                text-transform: uppercase;
                letter-spacing: .05em;
                color: var(--muted);
                font-weight: 600;
                text-align: left;
                padding: .75rem 1rem;
                border-bottom: 1px solid var(--line);
                white-space: nowrap
            }

            table.tx td {
                padding: .85rem 1rem;
                border-bottom: 1px solid var(--line-2);
                font-size: .88rem;
                color: var(--navy);
                vertical-align: middle
            }

            table.tx tbody tr {
                transition: .15s
            }

                table.tx tbody tr:hover {
                    background: var(--cream)
                }

        .dest-img {
            width: 62px;
            height: 44px;
            border-radius: 10px;
            object-fit: cover;
            border: 1px solid var(--line-2);
            display: block
        }

        .no-img {
            width: 62px;
            height: 44px;
            border-radius: 10px;
            background: var(--cream);
            border: 1px solid var(--line);
            display: grid;
            place-items: center;
            color: var(--muted);
            font-size: .72rem
        }

        .badge-x {
            font-size: .74rem;
            font-weight: 600;
            padding: .28rem .7rem;
            border-radius: 999px;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            gap: .35rem
        }

            .badge-x::before {
                content: "";
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: currentColor
            }

        .b-ok {
            background: var(--ok-bg);
            color: var(--ok-fg)
        }

        .b-muted {
            background: var(--cream);
            color: var(--muted);
            border: 1px solid var(--line)
        }

        .act-btn {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: #fff;
            border: 1px solid var(--line);
            display: grid;
            place-items: center;
            color: var(--muted);
            cursor: pointer;
            transition: .2s
        }

            .act-btn:hover {
                border-color: var(--teal);
                color: var(--teal-dark)
            }

        .dropdown-menu {
            border: 1px solid var(--line);
            border-radius: 12px;
            box-shadow: var(--shadow-md);
            padding: .4rem;
            font-size: .88rem;
            min-width: 160px
        }

        .dropdown-item {
            border-radius: 8px;
            padding: .5rem .7rem;
            font-weight: 500;
            color: var(--navy);
            display: flex;
            align-items: center;
            gap: .6rem
        }

            .dropdown-item:hover {
                background: var(--cream);
                color: var(--teal-dark)
            }

            .dropdown-item svg {
                color: var(--muted)
            }

            .dropdown-item:hover svg {
                color: var(--teal-dark)
            }

            .dropdown-item.danger {
                color: var(--cancel-fg)
            }

                .dropdown-item.danger svg {
                    color: var(--cancel-fg)
                }

                .dropdown-item.danger:hover {
                    background: var(--cancel-bg)
                }

        /* EMPTY */
        .empty {
            text-align: center;
            padding: 3.5rem 1rem
        }

            .empty .eic {
                width: 60px;
                height: 60px;
                border-radius: 16px;
                background: rgba(15,163,163,.1);
                color: var(--teal-dark);
                display: grid;
                place-items: center;
                margin: 0 auto 1rem
            }

            .empty h3 {
                font-family: 'Sora';
                font-weight: 700;
                color: var(--navy);
                font-size: 1.2rem
            }

            .empty p {
                color: var(--muted);
                margin: .3rem 0 1.2rem
            }
    </style>
}

<div class="page-intro">
    <div>
        <div class="eyebrow">@L["Katalog Yönetimi"]</div>
        <h1>@L["Destinasyonlar"]</h1>
        <p>@L["Sistemdeki tur destinasyonlarını (şehir/ülke) listeleyin ve yönetin."]</p>
    </div>
    <a href="/Admin/Destination/CreateDestination" class="btn-teal">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
        @L["Yeni Destinasyon Ekle"]
    </a>
</div>

<!-- 4 ADET KPI KARTI -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="kpi">
            <div class="ic">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
            </div>
            <div>
                <div class="num">@totalDest</div>
                <div class="lab">@L["Toplam Destinasyon"]</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi">
            <div class="ic ok">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15 8.5 22 9.3 17 14 18.2 21 12 17.6 5.8 21 7 14 2 9.3 9 8.5 12 2" /></svg>
            </div>
            <div>
                <div class="num">@popularDest</div>
                <div class="lab">@L["Popüler Destinasyon"]</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi">
            <div class="ic gray">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M2 12h20" /></svg>
            </div>
            <div>
                <div class="num">@standardDest</div>
                <div class="lab">@L["Standart Rota"]</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi">
            <div class="ic">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" /></svg>
            </div>
            <div>
                <div class="num">@uniqueCountries</div>
                <div class="lab">@L["Farklı Ülke"]</div>
            </div>
        </div>
    </div>
</div>

<!-- FİLTRELEME ÇUBUĞU -->
<div class="card-x filter-bar mb-3">
    <div class="row g-2 align-items-center">
        <div class="col-lg-6 col-md-6">
            <div class="f-search">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                <input type="text" id="fSearch" placeholder="@L["Şehir, ülke veya ID ara..."]">
            </div>
        </div>
        <div class="col-lg-4 col-md-4">
            <select class="f-select" id="fStatus">
                <option value="">@L["Tüm Popülerlik Durumları"]</option>
                <option value="true">@L["Popüler"]</option>
                <option value="false">@L["Standart"]</option>
            </select>
        </div>
        <div class="col-lg-2 col-md-2">
            <button type="button" class="btn-clear" onclick="clearFilters()">@L["Temizle"]</button>
        </div>
    </div>
</div>

<div class="result-line"><b id="resultCount">@totalDest</b> @L["destinasyon listeleniyor"]</div>

<!-- TABLO -->
<div class="card-x mb-4">
    <div class="tbl-wrap">
        <table class="tx">
            <thead>
                <tr>
                    <th style="width: 80px;">@L["Görsel"]</th>
                    <th>@L["Şehir / Ülke"]</th>
                    <th>@L["Popülerlik"]</th>
                    <th style="text-align: right; width: 60px;">@L["İşlemler"]</th>
                </tr>
            </thead>
            <tbody id="destRows">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var searchStr = $"{item.City} {item.Country} {item.Id}".ToLower();

                        <tr class="dest-row"
                            data-search="@searchStr"
                            data-status="@item.IsPopular.ToString().ToLower()">
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.City" class="dest-img" />
                                }
                                else
                                {
                                    <div class="no-img">@L["Görsel Yok"]</div>
                                }
                            </td>
                            <td>
                                <b style="color: var(--navy); font-size: .95rem; display: block;">@item.City</b>
                                <span style="color: var(--muted); font-size: .82rem;">@item.Country</span>
                                <span style="display: block; color: var(--muted); font-size: .74rem;">ID: @item.Id</span>
                            </td>
                            <td>
                                <span class="badge-x @(item.IsPopular ? "b-ok" : "b-muted")">
                                    @(item.IsPopular ? L["Popüler"].Value : L["Standart"].Value)
                                </span>
                            </td>
                            <td style="text-align: right; white-space: nowrap;">
                                <div class="dropdown d-inline-block">
                                    <button class="act-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="@L["İşlemler"]">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                            <circle cx="12" cy="5" r="1.7" />
                                            <circle cx="12" cy="12" r="1.7" />
                                            <circle cx="12" cy="19" r="1.7" />
                                        </svg>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item" href="/Admin/Destination/UpdateDestination/@item.Id">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z" /></svg>
                                                @L["Düzenle"]
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item danger" href="/Admin/Destination/DeleteDestination/@item.Id" onclick="return confirm('@L["Bu destinasyonu silmek istediğinize emin misiniz?"]');">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /></svg>
                                                @L["Sil"]
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- BOŞ DURUM -->
    <div id="emptyState" style="display:@(totalDest == 0 ? "block" : "none")">
        <div class="empty">
            <div class="eic">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
            </div>
            <h3>@L["Destinasyon bulunamadı"]</h3>
            <p>@L["Arama veya filtre kriterlerinizi değiştirerek tekrar deneyebilirsiniz."]</p>
            <button type="button" class="btn-clear" style="width:auto;margin:0 auto;padding:.5rem 1.2rem" onclick="clearFilters()">@L["Filtreleri Temizle"]</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterTable() {
            const q = document.getElementById("fSearch").value.trim().toLowerCase();
            const st = document.getElementById("fStatus").value;
            const rows = document.querySelectorAll("#destRows tr.dest-row");
            let count = 0;

            rows.forEach(r => {
                const searchData = r.getAttribute("data-search") || "";
                const statusData = r.getAttribute("data-status") || "";

                let matches = true;
                if (q && !searchData.includes(q)) matches = false;
                if (st && statusData !== st) matches = false;

                if (matches) {
                    r.style.display = "";
                    count++;
                } else {
                    r.style.display = "none";
                }
            });

            document.getElementById("resultCount").textContent = count;
            document.getElementById("emptyState").style.display = count === 0 ? "block" : "none";
        }

        document.getElementById("fSearch").addEventListener("input", filterTable);
        document.getElementById("fStatus").addEventListener("change", filterTable);

        function clearFilters() {
            document.getElementById("fSearch").value = "";
            document.getElementById("fStatus").value = "";
            filterTable();
        }
    </script>
}