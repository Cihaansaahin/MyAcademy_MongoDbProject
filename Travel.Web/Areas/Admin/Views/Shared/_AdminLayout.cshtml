@using Microsoft.AspNetCore.Builder
@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Options

@inject IOptions<RequestLocalizationOptions> LocOptions

@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.UICulture.TwoLetterISOLanguageName ?? "tr";
    var isEn = currentCulture == "en";
    var returnUrl = string.IsNullOrEmpty(Context.Request.Path) ? "~/" : $"{Context.Request.Path.Value}{Context.Request.QueryString}";
}

<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Travelio Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin-style.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <aside class="sidebar" id="sidebar">
        <div class="sb-brand">
            <span class="dot"></span>
            <span class="txt"><b>Travelio</b><span>Admin Panel</span></span>
        </div>
        <nav class="sb-menu">
            <div class="sb-cap">@(isEn ? "MANAGEMENT" : "Yönetim")</div>
            <a class="sb-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
                @(isEn ? "Dashboard" : "Dashboard")
            </a>
            <a class="sb-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tour" ? "active" : "")" asp-area="Admin" asp-controller="Tour" asp-action="Index">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h18v12H3z" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                @(isEn ? "Tours" : "Turlar")
            </a>
            <a class="sb-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reservation" ? "active" : "")" asp-area="Admin" asp-controller="Reservation" asp-action="Index">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
                @(isEn ? "Reservations" : "Rezervasyonlar")
            </a>
            <a class="sb-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Comment" ? "active" : "")" asp-area="Admin" asp-controller="Comment" asp-action="Index">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                @(isEn ? "Reviews" : "Yorumlar")
            </a>
            <a class="sb-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Question" ? "active" : "")" asp-area="Admin" asp-controller="Question" asp-action="Index">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3" /><line x1="12" y1="17" x2="12" y2="17" /></svg>
                @(isEn ? "Questions" : "Sorular")
            </a>

            <div class="sb-cap">@(isEn ? "CATALOG" : "Katalog")</div>
            <a class="sb-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "active" : "")" asp-area="Admin" asp-controller="Category" asp-action="Index">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" /></svg>
                @(isEn ? "Categories" : "Kategoriler")
            </a>
            <a class="sb-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Destination" ? "active" : "")" asp-area="Admin" asp-controller="Destination" asp-action="Index">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
                @(isEn ? "Destinations" : "Destinasyonlar")
            </a>

            <div class="sb-cap">@(isEn ? "OTHER" : "Diğer")</div>
            <a class="sb-link" asp-area="" asp-controller="Home" asp-action="Index">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12l9-9 9 9" /><path d="M9 21V9h6v12" /></svg>
                @(isEn ? "Back to Site" : "Siteye Dön")
            </a>
        </nav>
        <div class="sb-foot">
            <div class="sb-user">
                <div class="av">AD</div>
                <div><b>Admin</b><span>@(isEn ? "Manager" : "Yönetici")</span></div>
            </div>
        </div>
    </aside>
    <div class="sb-overlay" id="sbOverlay" onclick="toggleSidebar(false)"></div>

    <div class="main">
        <header class="topbar">
            <button class="hamb" onclick="toggleSidebar(true)" aria-label="Menü"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg></button>
            <span class="tb-title">@ViewData["Title"]</span>

            <div class="tb-right d-flex align-items-center gap-3">
                <!-- DİL SEÇİCİ DROPDOWN (TR / EN) -->
                <div class="dropdown d-inline-block">
                    <button class="btn btn-sm d-inline-flex align-items-center gap-2"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            style="background: #fff; border: 1px solid var(--line-2); border-radius: 8px; font-weight: 600; font-size: .84rem; padding: .45rem .75rem; color: var(--navy); box-shadow: var(--shadow-sm);">
                        @if (isEn)
                        {
                            <span>🇬🇧 English</span>
                        }
                        else
                        {
                            <span>🇹🇷 Türkçe</span>
                        }
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm"
                        style="border-radius: 10px; border: 1px solid var(--line-2); font-family: 'Sora', sans-serif; font-size: .84rem; padding: .4rem; min-width: 140px; background: #fff;">
                        <li>
                            <form asp-area="" asp-controller="Language" asp-action="SetLanguage" method="post" class="m-0 p-0">
                                <input type="hidden" name="culture" value="tr-TR" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="dropdown-item d-flex align-items-center gap-2" style="border-radius: 6px; padding: .45rem .7rem; font-weight: 600; color: var(--navy);">
                                    🇹🇷 Türkçe
                                </button>
                            </form>
                        </li>
                        <li>
                            <form asp-area="" asp-controller="Language" asp-action="SetLanguage" method="post" class="m-0 p-0">
                                <input type="hidden" name="culture" value="en-US" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="dropdown-item d-flex align-items-center gap-2" style="border-radius: 6px; padding: .45rem .7rem; font-weight: 600; color: var(--navy);">
                                    🇬🇧 English
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>

                <div class="tb-user">
                    <div class="av">AD</div>
                    <div class="nm"><b>Admin</b><span>@(isEn ? "Manager" : "Yönetici")</span></div>
                </div>
            </div>
        </header>

        <div class="content">
            @RenderBody()
        </div>

        <footer class="admin-foot">
            <span>© 2026 Travelio Admin Panel</span>
            <span>v1.0</span>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar(show){
        document.getElementById("sidebar").classList.toggle("show", show);
        document.getElementById("sbOverlay").classList.toggle("show", show);
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>