@model Travel.Web.DTOs.QuestionDtos.AnswerQuestionDto
@{
    var isEn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLower() == "en";
    ViewData["Title"] = isEn ? "Answer Question" : "Soruyu Yanıtla";
    var userInitial = string.IsNullOrEmpty(ViewBag.UserName as string) ? "U" : ((string)ViewBag.UserName).Substring(0, 1).ToUpper();
}

@section Styles {
    <style>
        :root {
            --navy: #0e2a3b;
            --navy-2: #12384c;
            --navy-3: #1b455c;
            --teal: #0fa3a3;
            --teal-dark: #0b7f80;
            --cream: #f7f5f0;
            --bg: #f4f5f4;
            --white: #fff;
            --ink: #0e2a3b;
            --muted: #6a7c88;
            --line: #e7e2d8;
            --line-2: #eef0ef;
            --shadow-sm: 0 4px 18px rgba(14,42,59,.06);
            --shadow-md: 0 18px 50px rgba(14,42,59,.12);
            --r: 16px;
        }

        .crumb {
            font-size: .8rem;
            color: var(--muted);
            margin-bottom: .4rem
        }

            .crumb a {
                color: var(--muted);
                text-decoration: none
            }

                .crumb a:hover {
                    color: var(--teal-dark)
                }

            .crumb .cur {
                color: var(--navy);
                font-weight: 600
            }

        .page-intro {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 1.5rem
        }

            .page-intro h1 {
                font-weight: 700;
                font-size: 1.7rem;
                color: var(--navy);
                margin: .15rem 0 .3rem
            }

            .page-intro p {
                color: var(--muted);
                margin: 0;
                font-size: .94rem;
                max-width: 64ch
            }

        .btn-teal {
            background: var(--teal);
            color: #fff;
            border: none;
            border-radius: 999px;
            font-weight: 600;
            padding: .7rem 1.3rem;
            font-size: .9rem;
            transition: .25s;
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            white-space: nowrap;
            cursor: pointer
        }

            .btn-teal:hover {
                background: var(--teal-dark);
                color: #fff;
                box-shadow: 0 12px 26px rgba(15,163,163,.3)
            }

        .btn-ghost {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 999px;
            font-weight: 600;
            padding: .65rem 1.2rem;
            font-size: .88rem;
            color: var(--navy);
            transition: .2s;
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            white-space: nowrap;
            cursor: pointer;
            text-decoration: none
        }

            .btn-ghost:hover {
                border-color: var(--teal);
                color: var(--teal-dark)
            }

        /* SECTION CARD */
        .sec {
            background: #fff;
            border: 1px solid var(--line-2);
            border-radius: var(--r);
            box-shadow: var(--shadow-sm);
            padding: 1.5rem 1.6rem;
            margin-bottom: 1.3rem
        }

        .sec-head {
            margin-bottom: 1.2rem
        }

            .sec-head h2 {
                font-family: 'Sora';
                font-weight: 700;
                font-size: 1.12rem;
                color: var(--navy);
                margin: 0;
                display: flex;
                align-items: center;
                gap: .6rem
            }

            .sec-head .sec-ic {
                width: 32px;
                height: 32px;
                border-radius: 9px;
                background: rgba(15,163,163,.1);
                color: var(--teal-dark);
                display: grid;
                place-items: center;
                flex: none
            }

            .sec-head p {
                color: var(--muted);
                font-size: .86rem;
                margin: .4rem 0 0
            }

        /* QUESTION SUMMARY CARD */
        .q-summary {
            background: var(--cream);
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 1.2rem 1.3rem;
            margin-bottom: 1.4rem;
            display: flex;
            gap: .9rem;
            align-items: flex-start
        }

        .q-av {
            width: 40px;
            height: 40px;
            border-radius: 11px;
            background: var(--navy);
            color: #fff;
            display: grid;
            place-items: center;
            font-size: .9rem;
            font-weight: 700;
            font-family: 'Sora';
            flex: none
        }

        .q-meta {
            font-size: .8rem;
            color: var(--muted);
            margin-bottom: .25rem
        }

            .q-meta b {
                color: var(--navy)
            }

        .q-txt {
            font-size: 1rem;
            font-weight: 600;
            color: var(--navy);
            line-height: 1.45
        }

        /* FIELDS */
        .field {
            margin-bottom: 1rem
        }

            .field label {
                display: block;
                font-size: .8rem;
                font-weight: 600;
                color: var(--navy);
                margin-bottom: .35rem
            }

                .field label .req {
                    color: var(--cancel-fg)
                }

        .ctrl {
            width: 100%;
            border: 1px solid var(--line);
            background: var(--cream);
            border-radius: 11px;
            padding: .75rem .95rem;
            font-size: .92rem;
            color: var(--navy);
            outline: none;
            transition: .2s;
            font-family: inherit
        }

            .ctrl::placeholder {
                color: #a7b2ba
            }

            .ctrl:focus {
                border-color: var(--teal);
                background: #fff;
                box-shadow: 0 0 0 3px rgba(15,163,163,.12)
            }

        textarea.ctrl {
            resize: vertical;
            min-height: 120px;
            line-height: 1.6
        }

        /* ACTION BAR */
        .action-bar {
            position: sticky;
            bottom: 0;
            background: rgba(255,255,255,.92);
            backdrop-filter: blur(10px);
            border: 1px solid var(--line-2);
            border-radius: 14px;
            box-shadow: var(--shadow-md);
            padding: .9rem 1.2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
            margin-top: .4rem;
            margin-bottom: .4rem;
            z-index: 100
        }

            .action-bar .saved {
                font-size: .83rem;
                color: var(--muted);
                display: flex;
                align-items: center;
                gap: .5rem
            }

            .action-bar .btns {
                display: flex;
                gap: .6rem;
                flex-wrap: wrap
            }
    </style>
}

<div class="crumb">
    <a href="/Admin/Dashboard">Dashboard</a> / <a href="/Admin/Question/Index">@(isEn ? "Questions" : "Sorular")</a> / <span class="cur">@(isEn ? "Answer Question" : "Soruyu Yanıtla")</span>
</div>
<div class="page-intro">
    <div>
        <h1>@(isEn ? "Answer Inquiries" : "Soruyu Yanıtla")</h1>
        <p>@(isEn ? "Write a response to the traveler's question or modify your existing answer." : "Kullanıcının sorusuna yanıt yazın veya mevcut yanıtı güncelleyin.")</p>
    </div>
    <a href="/Admin/Question/Index" class="btn-ghost">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
        @(isEn ? "Back to Questions" : "Sorulara Dön")
    </a>
</div>

<form asp-area="Admin" asp-controller="Question" asp-action="AnswerQuestion" method="post">
    <!-- ID ALANI -->
    <input type="hidden" asp-for="QuestionId" />

    <div class="sec">
        <div class="sec-head">
            <h2>
                <span class="sec-ic">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3" /><line x1="12" y1="17" x2="12" y2="17" /></svg>
                </span>
                @(isEn ? "Inquiry Details" : "Gelen Soru Bilgileri")
            </h2>
            <p>@(isEn ? "Question submitted by traveler on tour detail page." : "Kullanıcının tur detay sayfasından ilettiği soru ve detayları.")</p>
        </div>

        <!-- SORU KARTI -->
        <div class="q-summary">
            <div class="q-av">@userInitial</div>
            <div style="flex: 1; min-width: 0;">
                <div class="q-meta">
                    <b>@ViewBag.UserName</b> &bull; <span>@(((DateTime)ViewBag.AskedDate).ToString("dd.MM.yyyy HH:mm"))</span>
                </div>
                <div class="q-txt">
                    "@ViewBag.QuestionText"
                </div>
            </div>
        </div>

        <!-- CEVAP ALANI -->
        <div class="field">
            <label>@(isEn ? "Your Official Response" : "Cevabınız") <span class="req">*</span></label>
            <textarea asp-for="AnswerText" class="ctrl" rows="5" placeholder="@(isEn ? "Type the response to be sent to the user..." : "Kullanıcıya iletmek istediğiniz yanıtı buraya yazın...")" required></textarea>
        </div>
    </div>

    <!-- ACTION BAR -->
    <div class="action-bar">
        <div class="saved">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
            @(isEn ? "Awaiting your response" : "Yanıtınız bekleniyor")
        </div>
        <div class="btns">
            <a href="/Admin/Question/Index" class="btn-ghost">@(isEn ? "Cancel" : "Vazgeç")</a>
            <button type="submit" class="btn-teal">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13" /><polygon points="22 2 15 22 11 13 2 9 22 2" /></svg>
                @(isEn ? "Send Response" : "Yanıtı Gönder")
            </button>
        </div>
    </div>
</form>