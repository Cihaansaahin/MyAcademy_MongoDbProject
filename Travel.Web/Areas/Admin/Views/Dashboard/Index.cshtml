<!-- CHART.JS -->
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        const ctx = document.getElementById("resChart");
        if (ctx) {
        const grad = ctx.getContext("2d").createLinearGradient(0, 0, 0, 185);
        grad.addColorStop(0, "rgba(15,163,163,.28)");
        grad.addColorStop(1, "rgba(15,163,163,0)");

        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyChartLabels ?? new List<string>()));
        const data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyChartData ?? new List<int>()));
        const chartLabel = "@L["Rezervasyon"]";

        const chart = new Chart(ctx, {
        type: "line",
        data: {
        labels: labels.length ? labels : ["Mart","Nisan","Mayıs","Haziran","Temmuz","Ağustos"],
        datasets: [{
        label: chartLabel,
        data: data.length ? data : [0, 0, 0, 0, 0, 0],
        borderColor: "#0fa3a3",
        backgroundColor: grad,
        borderWidth: 2.5,
        fill: true,
        tension: .35,
        pointBackgroundColor: "#fff",
        pointBorderColor: "#0fa3a3",
        pointBorderWidth: 2,
        pointRadius: 3.5,
        pointHoverRadius: 5
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
        legend: { display: false },
        tooltip: {
        backgroundColor: "#0e2a3b",
        padding: 8,
        cornerRadius: 8,
        titleFont: { family: "Sora", size: 11 },
        bodyFont: { size: 11 },
        displayColors: false,
        callbacks: {
        label: c => c.parsed.y + " " + "@L["rezervasyon"]"
        }
        }
        },
        scales: {
        y: { beginAtZero: true, grid: { color: "#eef0ef" }, border: { display: false }, ticks: { color: "#6a7c88", font: { size: 10 } } },
        x: { grid: { display: false }, border: { display: false }, ticks: { color: "#6a7c88", font: { size: 11 } } }
        }
        }
        });

        document.getElementById("rangeSelect").addEventListener("change", () => chart.update());
        }
    </script>
}