@model Travel.Web.DTOs.CategoryDtos.CreateCategoryDto
@{
    var isEn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLower() == "en";
    ViewData["Title"] = L["Yeni Kategori Ekle"].Value;
}

@section Styles {
    <style>
        :root {
            --navy: #0e2a3b;
            --navy-2: #12384c;
            --navy-3: #1b455c;
            --teal: #0fa3a3;
            --teal-dark: #0b7f80;
            --cream: #f7f5f0;
            --bg: #f4f5f4;
            --white: #fff;
            --ink: #0e2a3b;
            --muted: #6a7c88;
            --line: #e7e2d8;
            --line-2: #eef0ef;
            --shadow-sm: 0 4px 18px rgba(14,42,59,.06);
            --shadow-md: 0 18px 50px rgba(14,42,59,.12);
            --r: 16px;
            --ok-bg: #e3f4f0;
            --ok-fg: #0b7f80;
            --cancel-bg: #f6e4e2;
            --cancel-fg: #b45a4f;
        }

        .crumb {
            font-size: .8rem;
            color: var(--muted);
            margin-bottom: .4rem
        }

            .crumb a {
                color: var(--muted);
                text-decoration: none
            }

                .crumb a:hover {
                    color: var(--teal-dark)
                }

            .crumb .cur {
                color: var(--navy);
                font-weight: 600
            }

        .page-intro {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 1.5rem
        }

            .page-intro h1 {
                font-weight: 700;
                font-size: 1.7rem;
                color: var(--navy);
                margin: .15rem 0 .3rem
            }

            .page-intro p {
                color: var(--muted);
                margin: 0;
                font-size: .94rem;
                max-width: 64ch
            }

        .btn-teal {
            background: var(--teal);
            color: #fff;
            border: none;
            border-radius: 999px;
            font-weight: 600;
            padding: .7rem 1.3rem;
            font-size: .9rem;
            transition: .25s;
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            white-space: nowrap;
            cursor: pointer
        }

            .btn-teal:hover {
                background: var(--teal-dark);
                color: #fff;
                box-shadow: 0 12px 26px rgba(15,163,163,.3)
            }

        .btn-ghost {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 999px;
            font-weight: 600;
            padding: .65rem 1.2rem;
            font-size: .88rem;
            color: var(--navy);
            transition: .2s;
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            white-space: nowrap;
            cursor: pointer;
            text-decoration: none
        }

            .btn-ghost:hover {
                border-color: var(--teal);
                color: var(--teal-dark)
            }

        /* SECTION CARD */
        .sec {
            background: #fff;
            border: 1px solid var(--line-2);
            border-radius: var(--r);
            box-shadow: var(--shadow-sm);
            padding: 1.5rem 1.6rem;
            margin-bottom: 1.3rem
        }

        .sec-head {
            margin-bottom: 1.2rem
        }

            .sec-head h2 {
                font-family: 'Sora';
                font-weight: 700;
                font-size: 1.12rem;
                color: var(--navy);
                margin: 0;
                display: flex;
                align-items: center;
                gap: .6rem
            }

            .sec-head .sec-ic {
                width: 32px;
                height: 32px;
                border-radius: 9px;
                background: rgba(15,163,163,.1);
                color: var(--teal-dark);
                display: grid;
                place-items: center;
                flex: none
            }

            .sec-head p {
                color: var(--muted);
                font-size: .86rem;
                margin: .4rem 0 0
            }

        /* FIELDS */
        .field {
            margin-bottom: 1rem
        }

            .field label {
                display: block;
                font-size: .8rem;
                font-weight: 600;
                color: var(--navy);
                margin-bottom: .35rem
            }

                .field label .req {
                    color: var(--cancel-fg)
                }

        .ctrl {
            width: 100%;
            border: 1px solid var(--line);
            background: var(--cream);
            border-radius: 11px;
            padding: .68rem .9rem;
            font-size: .9rem;
            color: var(--navy);
            outline: none;
            transition: .2s;
            font-family: inherit
        }

            .ctrl::placeholder {
                color: #a7b2ba
            }

            .ctrl:focus {
                border-color: var(--teal);
                background: #fff;
                box-shadow: 0 0 0 3px rgba(15,163,163,.12)
            }

        /* ICON PREVIEW BOX */
        .icon-preview-box {
            width: 54px;
            height: 54px;
            border-radius: 12px;
            background: var(--cream);
            border: 1px solid var(--line);
            display: grid;
            place-items: center;
            color: var(--teal-dark);
            font-size: 1.4rem;
            flex: none;
            transition: .2s
        }

        /* STATUS PILLS */
        .status-pills {
            display: flex;
            gap: .6rem;
            flex-wrap: wrap
        }

        .status-pill {
            flex: 1;
            min-width: 140px;
            border: 1px solid var(--line);
            border-radius: 11px;
            padding: .7rem .9rem;
            cursor: pointer;
            transition: .2s;
            background: var(--cream)
        }

            .status-pill:hover {
                border-color: var(--teal)
            }

            .status-pill.sel {
                border-color: var(--teal);
                background: rgba(15,163,163,.06);
                box-shadow: 0 0 0 2px rgba(15,163,163,.12)
            }

            .status-pill b {
                font-family: 'Sora';
                font-size: .9rem;
                color: var(--navy);
                display: block
            }

            .status-pill span {
                font-size: .76rem;
                color: var(--muted)
            }

            .status-pill input {
                display: none
            }

        /* ACTION BAR */
        .action-bar {
            position: sticky;
            bottom: 0;
            background: rgba(255,255,255,.92);
            backdrop-filter: blur(10px);
            border: 1px solid var(--line-2);
            border-radius: 14px;
            box-shadow: var(--shadow-md);
            padding: .9rem 1.2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
            margin-top: .4rem;
            margin-bottom: .4rem;
            z-index: 100
        }

            .action-bar .saved {
                font-size: .83rem;
                color: var(--muted);
                display: flex;
                align-items: center;
                gap: .5rem
            }

            .action-bar .btns {
                display: flex;
                gap: .6rem;
                flex-wrap: wrap
            }
    </style>
}

<div class="crumb">
    <a href="/Admin/Dashboard">Dashboard</a> / <a href="/Admin/Category/Index">@L["Kategoriler"]</a> / <span class="cur">@L["Yeni Kategori Ekle"]</span>
</div>
<div class="page-intro">
    <div>
        <div class="eyebrow">@L["Katalog Yönetimi"]</div>
        <h1>@L["Yeni Kategori Ekle"]</h1>
        <p>@L["Sisteme yeni bir tur kategorisi tanımlayın ve yayın durumunu belirleyin."]</p>
    </div>
    <a href="/Admin/Category/Index" class="btn-ghost">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
        @L["Kategorilere Dön"]
    </a>
</div>

<form asp-area="Admin" asp-controller="Category" asp-action="CreateCategory" method="post" id="categoryForm">
    <div class="sec">
        <div class="sec-head">
            <h2>
                <span class="sec-ic">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" /><line x1="7" y1="7" x2="7" y2="7" /></svg>
                </span>
                @L["Kategori Bilgileri"]
            </h2>
            <p>@L["Kategori adı, görsel ikon ve sitedeki görünüm ayarlarını belirleyin."]</p>
        </div>

        <div class="row g-3">
            <div class="col-md-6 field">
                <label>@L["Kategori Adı (TR 🇹🇷)"] <span class="req">*</span></label>
                <input class="ctrl" asp-for="Name.Tr" placeholder="Örn: Doğa & Macera" required>
            </div>

            <div class="col-md-6 field">
                <label>@L["Kategori Adı (EN 🇬🇧)"]</label>
                <input class="ctrl" asp-for="Name.En" placeholder="e.g. Nature & Adventure">
            </div>

            <div class="col-md-8 field">
                <label>@L["İkon Sınıfı, Emoji veya Görsel URL'si"]</label>
                <input class="ctrl" asp-for="IconUrl" id="iconInput" placeholder="Örn: fa-solid fa-mountain, 🏔️ veya https://..." oninput="updateIconPreview(this.value)">
                <small style="color:var(--muted);font-size:.76rem;margin-top:.3rem;display:block">
                    @L["FontAwesome sınıfı, doğrudan görsel linki veya emoji girebilirsiniz."]
                </small>
            </div>

            <div class="col-md-4 field">
                <label>@L["İkon Önizlemesi"]</label>
                <div class="d-flex align-items-center gap-2">
                    <div class="icon-preview-box" id="iconPreviewBox">🏷️</div>
                    <span style="font-size:.8rem;color:var(--muted)">@L["Canlı önizleme"]</span>
                </div>
            </div>

            <div class="col-12 field mt-2">
                <label>@L["Kategori Yayın Durumu"]</label>
                <div class="status-pills">
                    <label class="status-pill sel" data-status="true">
                        <input type="radio" name="IsActive" value="true" checked>
                        <b>@L["Aktif"]</b>
                        <span>@L["Filtrelerde ve sitede yayında"]</span>
                    </label>
                    <label class="status-pill" data-status="false">
                        <input type="radio" name="IsActive" value="false">
                        <b>@L["Pasif"]</b>
                        <span>@L["Kullanıcılara gizli"]</span>
                    </label>
                </div>
            </div>
        </div>
    </div>

    <!-- ACTION BAR -->
    <div class="action-bar">
        <div class="saved">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
            @L["Kaydedilmeye hazır"]
        </div>
        <div class="btns">
            <a href="/Admin/Category/Index" class="btn-ghost">@L["Vazgeç"]</a>
            <button type="submit" class="btn-teal">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                @L["Kategoriyi Kaydet"]
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        /* ---------- STATUS PILLS ---------- */
        document.querySelectorAll(".status-pill").forEach(p => {
            p.addEventListener("click", () => {
                document.querySelectorAll(".status-pill").forEach(x => x.classList.remove("sel"));
                p.classList.add("sel");
                p.querySelector("input").checked = true;
            });
        });

        /* ---------- ICON CANLI ÖNİZLEME ---------- */
        function updateIconPreview(val) {
            const box = document.getElementById("iconPreviewBox");
            const trimmed = (val || "").trim();

            if (!trimmed) {
                box.innerHTML = "🏷️";
                return;
            }

            if (trimmed.startsWith("http://") || trimmed.startsWith("https://") || trimmed.startsWith("/")) {
                box.innerHTML = `<img src="${trimmed}" alt="Icon" style="width:28px;height:28px;object-fit:contain;">`;
            } else if (trimmed.includes("fa-") || trimmed.includes("bi-")) {
                box.innerHTML = `<i class="${trimmed}"></i>`;
            } else {
                box.innerHTML = trimmed;
            }
        }
    </script>
}