@model CreateBannerDto
@{
    var isEn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLower() == "en";
    ViewData["Title"] = L["Yeni Banner Ekle"].Value;
}

@section Styles {
    <style>
        :root {
            --navy: #0e2a3b;
            --navy-2: #12384c;
            --navy-3: #1b455c;
            --teal: #0fa3a3;
            --teal-dark: #0b7f80;
            --cream: #f7f5f0;
            --bg: #f4f5f4;
            --white: #fff;
            --ink: #0e2a3b;
            --muted: #6a7c88;
            --line: #e7e2d8;
            --line-2: #eef0ef;
            --shadow-sm: 0 4px 18px rgba(14,42,59,.06);
            --shadow-md: 0 18px 50px rgba(14,42,59,.12);
            --r: 16px;
            --ok-bg: #e3f4f0;
            --ok-fg: #0b7f80;
            --cancel-bg: #f6e4e2;
            --cancel-fg: #b45a4f;
        }

        .crumb {
            font-size: .8rem;
            color: var(--muted);
            margin-bottom: .4rem
        }

            .crumb a {
                color: var(--muted);
                text-decoration: none
            }

                .crumb a:hover {
                    color: var(--teal-dark)
                }

            .crumb .cur {
                color: var(--navy);
                font-weight: 600
            }

        .page-intro {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 1.5rem
        }

            .page-intro h1 {
                font-weight: 700;
                font-size: 1.7rem;
                color: var(--navy);
                margin: .15rem 0 .3rem
            }

            .page-intro p {
                color: var(--muted);
                margin: 0;
                font-size: .94rem;
                max-width: 64ch
            }

        .btn-teal {
            background: var(--teal);
            color: #fff;
            border: none;
            border-radius: 999px;
            font-weight: 600;
            padding: .7rem 1.3rem;
            font-size: .9rem;
            transition: .25s;
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            white-space: nowrap;
            cursor: pointer
        }

            .btn-teal:hover {
                background: var(--teal-dark);
                color: #fff;
                box-shadow: 0 12px 26px rgba(15,163,163,.3)
            }

        .btn-ghost {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 999px;
            font-weight: 600;
            padding: .65rem 1.2rem;
            font-size: .88rem;
            color: var(--navy);
            transition: .2s;
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            white-space: nowrap;
            cursor: pointer;
            text-decoration: none
        }

            .btn-ghost:hover {
                border-color: var(--teal);
                color: var(--teal-dark)
            }

        /* SECTION CARD */
        .sec {
            background: #fff;
            border: 1px solid var(--line-2);
            border-radius: var(--r);
            box-shadow: var(--shadow-sm);
            padding: 1.5rem 1.6rem;
            margin-bottom: 1.3rem
        }

        .sec-head {
            margin-bottom: 1.2rem
        }

            .sec-head h2 {
                font-family: 'Sora';
                font-weight: 700;
                font-size: 1.12rem;
                color: var(--navy);
                margin: 0;
                display: flex;
                align-items: center;
                gap: .6rem
            }

            .sec-head .sec-ic {
                width: 32px;
                height: 32px;
                border-radius: 9px;
                background: rgba(15,163,163,.1);
                color: var(--teal-dark);
                display: grid;
                place-items: center;
                flex: none
            }

            .sec-head p {
                color: var(--muted);
                font-size: .86rem;
                margin: .4rem 0 0
            }

        /* FIELDS */
        .field {
            margin-bottom: 1rem
        }

            .field label {
                display: block;
                font-size: .8rem;
                font-weight: 600;
                color: var(--navy);
                margin-bottom: .35rem
            }

                .field label .req {
                    color: var(--cancel-fg)
                }

        .ctrl {
            width: 100%;
            border: 1px solid var(--line);
            background: var(--cream);
            border-radius: 11px;
            padding: .68rem .9rem;
            font-size: .9rem;
            color: var(--navy);
            outline: none;
            transition: .2s;
            font-family: inherit
        }

            .ctrl::placeholder {
                color: #a7b2ba
            }

            .ctrl:focus {
                border-color: var(--teal);
                background: #fff;
                box-shadow: 0 0 0 3px rgba(15,163,163,.12)
            }

        textarea.ctrl {
            resize: vertical;
            min-height: 90px;
            line-height: 1.6
        }

        /* UPLOAD & PREVIEW */
        .upload {
            border: 1.5px dashed var(--line);
            border-radius: 14px;
            padding: 1.6rem 1rem;
            text-align: center;
            background: var(--cream);
            cursor: pointer;
            transition: .2s;
            display: block
        }

            .upload:hover {
                border-color: var(--teal);
                background: rgba(15,163,163,.04)
            }

            .upload .uic {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background: #fff;
                border: 1px solid var(--line);
                color: var(--teal-dark);
                display: grid;
                place-items: center;
                margin: 0 auto .6rem
            }

            .upload b {
                font-family: 'Sora';
                font-size: .9rem;
                color: var(--navy);
                display: block
            }

            .upload span {
                font-size: .78rem;
                color: var(--muted)
            }

        .cover-preview {
            margin-top: .9rem;
            border-radius: 12px;
            overflow: hidden;
            max-width: 320px;
            border: 1px solid var(--line)
        }

            .cover-preview img {
                width: 100%;
                display: block
            }

        /* ACTION BAR */
        .action-bar {
            position: sticky;
            bottom: 0;
            background: rgba(255,255,255,.92);
            backdrop-filter: blur(10px);
            border: 1px solid var(--line-2);
            border-radius: 14px;
            box-shadow: var(--shadow-md);
            padding: .9rem 1.2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
            margin-top: .4rem;
            margin-bottom: .4rem;
            z-index: 100
        }

            .action-bar .saved {
                font-size: .83rem;
                color: var(--muted);
                display: flex;
                align-items: center;
                gap: .5rem
            }

            .action-bar .btns {
                display: flex;
                gap: .6rem;
                flex-wrap: wrap
            }
    </style>
}

<div class="crumb">
    <a href="/Admin/Dashboard">Dashboard</a> / <a href="/Admin/Banner/Index">@L["Bannerlar"]</a> / <span class="cur">@L["Yeni Banner Ekle"]</span>
</div>
<div class="page-intro">
    <div>
        <div class="eyebrow">@L["İçerik Yönetimi"]</div>
        <h1>@L["Yeni Banner Ekle"]</h1>
        <p>@L["Ana sayfa karşılama alanında yer alacak yeni bir banner görseli ve metni oluşturun."]</p>
    </div>
    <a href="/Admin/Banner/Index" class="btn-ghost">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
        @L["Bannerlara Dön"]
    </a>
</div>

<form asp-area="Admin" asp-controller="Banner" asp-action="Create" method="post" id="bannerForm" enctype="multipart/form-data">
    <div class="sec">
        <div class="sec-head">
            <h2>
                <span class="sec-ic">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>
                </span>
                @L["Banner Bilgileri"]
            </h2>
            <p>@L["Banner için görsel belirleyin ve vitrin başlık/açıklama metinlerini girin."]</p>
        </div>

        <div class="row g-3">
            <div class="col-12 field">
                <label>@L["Banner Başlığı"] <span class="req">*</span></label>
                <input class="ctrl" asp-for="Title" placeholder="@L["Örn: Dünyanın En Güzel Rotalarını Keşfedin"]" required>
                <span class="text-danger" style="font-size:.78rem" asp-validation-for="Title"></span>
            </div>

            <div class="col-12 field">
                <label>@L["Banner Açıklaması"] <span class="req">*</span></label>
                <textarea class="ctrl" asp-for="Description" rows="3" placeholder="@L["Ana sayfada görünecek ilgi çekici kısa açıklama..."]" required></textarea>
                <span class="text-danger" style="font-size:.78rem" asp-validation-for="Description"></span>
            </div>

            <!-- GÖRSEL YÜKLEME VE URL GİRİŞİ -->
            <div class="col-12 field">
                <label>@L["Banner Görseli"] <span class="req">*</span></label>
                <label class="upload" for="bannerImgInput">
                    <div class="uic">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                    </div>
                    <b>@L["Banner görselini buraya sürükleyin veya seçin."]</b>
                    <span>JPG, PNG · Önerilen 1920x1080</span>
                </label>
                <input type="file" id="bannerImgInput" accept="image/*" style="display:none" onchange="previewImg(this)">

                <div class="cover-preview" id="coverPreview" style="display:none">
                    <img id="coverImg" alt="Preview">
                </div>

                <div class="mt-2">
                    <label style="font-size:.76rem;color:var(--muted);font-weight:600">@L["Veya doğrudan Görsel URL'si girin:"]</label>
                    <input class="ctrl" asp-for="ImageUrl" id="tImgUrl" placeholder="https://images.unsplash.com/..." oninput="previewUrl(this.value)">
                    <span class="text-danger" style="font-size:.78rem" asp-validation-for="ImageUrl"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- ACTION BAR -->
    <div class="action-bar">
        <div class="saved">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
            @L["Kaydedilmeye hazır"]
        </div>
        <div class="btns">
            <a href="/Admin/Banner/Index" class="btn-ghost">@L["Vazgeç"]</a>
            <button type="submit" class="btn-teal">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                @L["Bannerı Kaydet"]
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function previewImg(inp) {
            if (!inp.files || !inp.files[0]) return;
            const url = URL.createObjectURL(inp.files[0]);
            document.getElementById("coverImg").src = url;
            document.getElementById("coverPreview").style.display = "block";
        }

        function previewUrl(url) {
            if (!url || !url.trim()) return;
            document.getElementById("coverImg").src = url.trim();
            document.getElementById("coverPreview").style.display = "block";
        }
    </script>
}