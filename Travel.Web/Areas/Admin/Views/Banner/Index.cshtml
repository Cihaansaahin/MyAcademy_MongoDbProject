@model List<ResultBannerDto>
@{

    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Banner Alanı</h1>
<table class="table table-bordered table-hover">
    @{
        int count = 0;
    }
    <tr>
        <th>#</th>
        <th>Görsel</th>
        <th>Başlık</th>
        <th>Açıkama</th>
        <th>İşlemler</th>
    </tr>
    @foreach (var item in Model)
    {
        count++;
        <tr>
            <th>@count</th>
            <td><img src="@item.ImageUrl" class="img-thumbnail" alt="@item.Title" /></td>
            <td>@item.Title</td>
            <td>(@item.Description.Length>50? @item.Description.Substring(0,50) + "..." :@item.Description</td>
            <td>
                <a href="#" class="btn btn-outline-danger">Sil</a>
                <a href="#" class="btn btn-outline-info">Güncelle</a>
            </td>
        </tr>
    }
</table>

<a href="/Admin/Banner/Create" class="btn btn-outline-dark">Yeni Banner Alanı Ekle </a>