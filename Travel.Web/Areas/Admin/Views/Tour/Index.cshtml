@model List<Travel.Web.DTOs.TourDtos.ResultTourDto>
@{
    ViewData["Title"] = "Tur Yönetimi";
}

<div class="page-intro d-flex align-items-center justify-content-between mb-4">
    <div>
        <div class="eyebrow">Katalog Yönetimi</div>
        <h1 style="font-size: 1.8rem; font-weight: 700; color: var(--navy); margin-bottom: .25rem;">Turlar</h1>
        <p style="color: var(--muted); margin: 0;">Sistemde yayında olan ve taslak durumundaki tüm turları buradan yönetebilirsiniz.</p>
    </div>
    <a href="/Admin/Tour/CreateTour" class="btn" style="background: var(--teal); color: #fff; font-weight: 600; border-radius: 12px; padding: .65rem 1.3rem; display: inline-flex; align-items: center; gap: .5rem; box-shadow: 0 4px 14px rgba(15,163,163,.3);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
        Yeni Tur Ekle
    </a>
</div>

<div class="card-x" style="background: #fff; border: 1px solid var(--line-2); border-radius: var(--r); box-shadow: var(--shadow-sm); overflow: hidden;">
    <div class="table-responsive">
        <table class="table align-middle mb-0" style="border-collapse: collapse;">
            <thead style="background: #fafbfa; border-bottom: 1px solid var(--line-2);">
                <tr>
                    <th style="padding: 1rem 1.25rem; font-size: .8rem; text-transform: uppercase; color: var(--muted); font-weight: 600;">Tur</th>
                    <th style="padding: 1rem 1.25rem; font-size: .8rem; text-transform: uppercase; color: var(--muted); font-weight: 600;">Lokasyon</th>
                    <th style="padding: 1rem 1.25rem; font-size: .8rem; text-transform: uppercase; color: var(--muted); font-weight: 600;">Fiyat</th>
                    <th style="padding: 1rem 1.25rem; font-size: .8rem; text-transform: uppercase; color: var(--muted); font-weight: 600;">Süre</th>
                    <th style="padding: 1rem 1.25rem; font-size: .8rem; text-transform: uppercase; color: var(--muted); font-weight: 600;">Durum</th>
                    <th style="padding: 1rem 1.25rem; font-size: .8rem; text-transform: uppercase; color: var(--muted); font-weight: 600; text-align: right;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr style="border-bottom: 1px solid var(--line-2);">
                            <td style="padding: 1rem 1.25rem;">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(string.IsNullOrEmpty(item.CoverImageUrl) ? "https://placehold.co/100x70?text=No+Image" : item.CoverImageUrl)"
                                         alt="Tour Image"
                                         style="width: 54px; height: 42px; border-radius: 8px; object-fit: cover; border: 1px solid var(--line-2);" />
                                    <div>
                                        <b style="color: var(--navy); font-size: .92rem; display: block;">@(item.Title?.Value ?? item.Title?.Tr ?? "İsimsiz Tur")</b>
                                        <span style="color: var(--muted); font-size: .78rem;">ID: @item.Id</span>
                                    </div>
                                </div>
                            </td>
                            <td style="padding: 1rem 1.25rem; color: var(--ink); font-size: .88rem;">
                                @item.City, @item.Country
                            </td>
                            <td style="padding: 1rem 1.25rem; font-weight: 700; color: var(--teal-dark);">
                                @item.Price.ToString("N0") ₺
                            </td>
                            <td style="padding: 1rem 1.25rem; color: var(--ink); font-size: .88rem;">
                                @item.DurationDays Gün
                            </td>
                            <td style="padding: 1rem 1.25rem;">
                                @if (item.IsActive)
                                {
                                    <span style="background: var(--ok-bg); color: var(--ok-fg); padding: .25rem .65rem; border-radius: 999px; font-size: .78rem; font-weight: 600;">Aktif</span>
                                }
                                else
                                {
                                    <span style="background: var(--cancel-bg); color: var(--cancel-fg); padding: .25rem .65rem; border-radius: 999px; font-size: .78rem; font-weight: 600;">Pasif</span>
                                }
                            </td>
                            <td style="padding: 1rem 1.25rem; text-align: right;">
                                <div class="d-inline-flex gap-2">
                                    <a href="/Admin/Tour/UpdateTour/@item.Id" class="btn btn-sm" style="background: #eef3f6; color: var(--navy); border-radius: 8px; font-weight: 600; padding: .35rem .75rem;">Düzenle</a>
                                    <a href="/Admin/Tour/DeleteTour/@item.Id" onclick="return confirm('Bu turu silmek istediğinize emin misiniz?');" class="btn btn-sm" style="background: var(--cancel-bg); color: var(--cancel-fg); border-radius: 8px; font-weight: 600; padding: .35rem .75rem;">Sil</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5" style="color: var(--muted);">
                            Kayıtlı herhangi bir tur bulunamadı. Yeni bir tur ekleyerek başlayabilirsiniz.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>